<fetch version="1.0" output-format="xml-platform" mapping="logical" distinct="false">
  <entity name="pdg_purchaseorderline">
    <attribute name="pdg_purchaseorderline1" />
    <attribute name="pdg_purchaseorderid" />
    <attribute name="pdg_purchaseorderidname" />
    <attribute name="pdg_item" />
    <attribute name="pdg_itemname" />
    <attribute name="pdg_linestatus" />
    <attribute name="pdg_linestatusname" />
    <attribute name="pdg_quantity" />
    <attribute name="pdg_unitprice" />
    <attribute name="pdg_linetotal" />
    <attribute name="pdg_qtyreceived" />
    <attribute name="pdg_expecteddeliverydate" />
    <attribute name="pdg_promiseddeliverydate" />
    <attribute name="statecode" />
    <attribute name="pdg_purchaseorderlineid" />
    <order attribute="pdg_purchaseorderline1" descending="false" />
    <filter type="and">
      <condition attribute="statecode" operator="eq" value="0" />
    </filter>
  </entity>

</fetch>

