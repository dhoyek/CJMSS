    pdg_sheetstatus,
    pdg_closesheetstatus,
    pdg_progressstatus,
    pdg_productioncategory,
    
    -- Booleans (2)
    pdg_isended,
    pdg_isposted,
    
    -- References (4)
    pdg_designref,
    pdg_quotationref,
    pdg_moldref,
    pdg_markingref,
    
    -- Numeric (2)
    pdg_dolphincurrencycode,
    pdg_goldweight,
    
    -- Costs/Prices (4)
    pdg_totalcost,
    pdg_overheads,
    pdg_publicprice,
    pdg_localpricef,
    
    -- Legacy currency (9)
    pdg_legacycostforeign,
    pdg_legacycostlbp,
    pdg_legacycostsecondary,
    pdg_legacyexportpriceforeign,
    pdg_legacyexportpricelbp,
    pdg_legacyexportpricesecondary,
    pdg_legacylocalpricef,
    pdg_legacylocalpricelbp,
    pdg_legacylocalpricesecondary
FROM dbo.ProductionSheet_Staging
ORDER BY staging_id;</property>
