    <DTS:Executable
      DTS:refId="Package\SQL_Identify-Duplicates-And-Create-Hierarchy-Mapping_Client"
      DTS:CreationName="Microsoft.DbMaintenanceTSQLExecuteTask"
      DTS:Description="Execute T-SQL Statement Task"
      DTS:DTSID="{FA9CEF53-6F6F-408E-82BD-B15AD71FAC72}"
      DTS:ExecutableType="Microsoft.DbMaintenanceTSQLExecuteTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Identify-Duplicates-And-Create-Hierarchy-Mapping_Client"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9D3F105A-54A2-454A-8289-33FCE7058322}"
          SQLTask:SqlStatementSource="USE MetierDartStagingDB;&#xA;GO&#xA;&#xA;-- Start logging&#xA;DECLARE @BatchID VARCHAR(50) = CONVERT(VARCHAR, GETDATE(), 112) + '_' + &#xA;                               REPLACE(CONVERT(VARCHAR, GETDATE(), 108), ':', '');&#xA;DECLARE @StepStart DATETIME2 = GETDATE();&#xA;&#xA;INSERT INTO Migration_Log (batch_id, step_name, step_status, start_time)&#xA;VALUES (@BatchID, 'Identify Duplicates', 'Started', @StepStart);&#xA;&#xA;-- Clear previous mapping data&#xA;TRUNCATE TABLE Client_Hierarchy_Mapping;&#xA;&#xA;-- =====================================================================&#xA;-- STEP 1: Identify Duplicate Groups&#xA;-- =====================================================================&#xA;&#xA;-- Create temp table for duplicate analysis&#xA;IF OBJECT_ID('tempdb..#DuplicateGroups') IS NOT NULL DROP TABLE #DuplicateGroups;&#xA;&#xA;SELECT &#xA;    name as customer_name,&#xA;    COUNT(*) as duplicate_count,&#xA;    MIN(seq) as primary_seq,    -- Lowest seq becomes master&#xA;    STRING_AGG(CAST(seq AS VARCHAR), ',') WITHIN GROUP (ORDER BY seq) as all_seqs&#xA;INTO #DuplicateGroups&#xA;FROM Client_Staging&#xA;GROUP BY name&#xA;HAVING COUNT(*) &gt; 1;&#xA;&#xA;PRINT 'Duplicate groups identified: ' + CAST(@@ROWCOUNT AS VARCHAR);&#xA;&#xA;-- =====================================================================&#xA;-- STEP 2: Insert MASTER Account Mappings&#xA;-- =====================================================================&#xA;&#xA;INSERT INTO Client_Hierarchy_Mapping (&#xA;    source_seq,&#xA;    customer_name,&#xA;    record_type,&#xA;    is_duplicate,&#xA;    duplicate_group_name,&#xA;    duplicate_count,&#xA;    pdg_legacyid,           -- ✅ EXACT primary seq&#xA;    accountnumber,          -- ✅ M- prefix for identification&#xA;    parent_seq,&#xA;    is_primary_in_group&#xA;)&#xA;SELECT &#xA;    dg.primary_seq as source_seq,&#xA;    dg.customer_name,&#xA;    'MASTER' as record_type,&#xA;    1 as is_duplicate,&#xA;    dg.customer_name as duplicate_group_name,&#xA;    dg.duplicate_count,&#xA;    CAST(dg.primary_seq AS VARCHAR(50)) as pdg_legacyid,  -- ✅ EXACT: &quot;1182&quot;&#xA;    'M-' + CAST(dg.primary_seq AS VARCHAR(50)) as accountnumber, -- ✅ &quot;M-1182&quot;&#xA;    NULL as parent_seq,&#xA;    1 as is_primary_in_group&#xA;FROM #DuplicateGroups dg;&#xA;&#xA;DECLARE @MasterCount INT = @@ROWCOUNT;&#xA;PRINT 'Master account mappings created: ' + CAST(@MasterCount AS VARCHAR);&#xA;&#xA;-- =====================================================================&#xA;-- STEP 3: Insert CHILD Account Mappings&#xA;-- =====================================================================&#xA;&#xA;INSERT INTO Client_Hierarchy_Mapping (&#xA;    source_seq,&#xA;    customer_name,&#xA;    record_type,&#xA;    is_duplicate,&#xA;    duplicate_group_name,&#xA;    duplicate_count,&#xA;    pdg_legacyid,           -- ✅ EXACT seq&#xA;    accountnumber,          -- ✅ C- prefix for identification&#xA;    parent_seq,&#xA;    is_primary_in_group&#xA;)&#xA;SELECT &#xA;    cs.seq as source_seq,&#xA;    cs.name as customer_name,&#xA;    'CHILD' as record_type,&#xA;    1 as is_duplicate,&#xA;    dg.customer_name as duplicate_group_name,&#xA;    dg.duplicate_count,&#xA;    CAST(cs.seq AS VARCHAR(50)) as pdg_legacyid,  -- ✅ EXACT: &quot;5332&quot;&#xA;    'C-' + CAST(cs.seq AS VARCHAR(50)) as accountnumber, -- ✅ &quot;C-5332&quot;&#xA;    dg.primary_seq as parent_seq,&#xA;    0 as is_primary_in_group&#xA;FROM Client_Staging cs&#xA;INNER JOIN #DuplicateGroups dg ON cs.name = dg.customer_name;&#xA;&#xA;DECLARE @ChildCount INT = @@ROWCOUNT;&#xA;PRINT 'Child account mappings created: ' + CAST(@ChildCount AS VARCHAR);&#xA;&#xA;-- =====================================================================&#xA;-- STEP 4: Insert SINGLE Account Mappings (Non-duplicates)&#xA;-- =====================================================================&#xA;&#xA;INSERT INTO Client_Hierarchy_Mapping (&#xA;    source_seq,&#xA;    customer_name,&#xA;    record_type,&#xA;    is_duplicate,&#xA;    duplicate_group_name,&#xA;    duplicate_count,&#xA;    pdg_legacyid,           -- ✅ EXACT seq&#xA;    accountnumber,          -- ✅ S- prefix for identification&#xA;    parent_seq,&#xA;    is_primary_in_group&#xA;)&#xA;SELECT &#xA;    cs.seq as source_seq,&#xA;    cs.name as customer_name,&#xA;    'SINGLE' as record_type,&#xA;    0 as is_duplicate,&#xA;    NULL as duplicate_group_name,&#xA;    1 as duplicate_count,&#xA;    CAST(cs.seq AS VARCHAR(50)) as pdg_legacyid,  -- ✅ EXACT: &quot;1&quot;&#xA;    'S-' + CAST(cs.seq AS VARCHAR(50)) as accountnumber, -- ✅ &quot;S-1&quot;&#xA;    NULL as parent_seq,&#xA;    0 as is_primary_in_group&#xA;FROM Client_Staging cs&#xA;WHERE cs.name NOT IN (SELECT customer_name FROM #DuplicateGroups);&#xA;&#xA;DECLARE @SingleCount INT = @@ROWCOUNT;&#xA;PRINT 'Single account mappings created: ' + CAST(@SingleCount AS VARCHAR);&#xA;&#xA;-- =====================================================================&#xA;-- Verification&#xA;-- =====================================================================&#xA;&#xA;SELECT &#xA;    record_type,&#xA;    COUNT(*) as count&#xA;FROM Client_Hierarchy_Mapping&#xA;GROUP BY record_type&#xA;ORDER BY record_type;&#xA;&#xA;-- Verify totals&#xA;DECLARE @TotalMappings INT = (SELECT COUNT(*) FROM Client_Hierarchy_Mapping);&#xA;DECLARE @TotalStaging INT = (SELECT COUNT(*) FROM Client_Staging);&#xA;DECLARE @ExpectedTotal INT = @MasterCount + @ChildCount + @SingleCount;&#xA;&#xA;PRINT '';&#xA;PRINT 'Summary:';&#xA;PRINT '  Masters: ' + CAST(@MasterCount AS VARCHAR);&#xA;PRINT '  Children: ' + CAST(@ChildCount AS VARCHAR);&#xA;PRINT '  Singles: ' + CAST(@SingleCount AS VARCHAR);&#xA;PRINT '  Total Mappings: ' + CAST(@TotalMappings AS VARCHAR);&#xA;PRINT '  Expected: ' + CAST(@ExpectedTotal AS VARCHAR);&#xA;PRINT '  Source Records: ' + CAST(@TotalStaging AS VARCHAR);&#xA;&#xA;-- Log completion&#xA;UPDATE Migration_Log&#xA;SET step_status = 'Completed',&#xA;    end_time = GETDATE(),&#xA;    records_processed = @TotalMappings,&#xA;    message = 'Masters: ' + CAST(@MasterCount AS VARCHAR) + &#xA;              ', Children: ' + CAST(@ChildCount AS VARCHAR) +&#xA;              ', Singles: ' + CAST(@SingleCount AS VARCHAR)&#xA;WHERE batch_id = @BatchID AND step_name = 'Identify Duplicates';&#xA;&#xA;-- Cleanup&#xA;DROP TABLE #DuplicateGroups;&#xA;&#xA;PRINT 'Hierarchy mapping completed successfully!';"
          SQLTask:ServerVersion="9"
          SQLTask:ExtendedLogging="True"
          SQLTask:LocalConnectionForLogging=""
          SQLTask:TaskName=""
          SQLTask:IgnoreDatabasesInNotOnlineState="False" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_LinkParentAccounts_Client"
      DTS:CreationName="Microsoft.DbMaintenanceTSQLExecuteTask"
      DTS:Description="Execute T-SQL Statement Task"
      DTS:DTSID="{25C381EE-335B-47C7-BB33-8E091CA6B61E}"
      DTS:ExecutableType="Microsoft.DbMaintenanceTSQLExecuteTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_LinkParentAccounts_Client"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9D3F105A-54A2-454A-8289-33FCE7058322}"
          SQLTask:SqlStatementSource="USE MetierDartStagingDB;&#xA;GO&#xA;&#xA;-- =====================================================================&#xA;-- Link child accounts to their parent accounts&#xA;-- =====================================================================&#xA;&#xA;PRINT 'Linking parent-child relationships...';&#xA;&#xA;-- Update child accounts with parent accountid&#xA;UPDATE ct_child&#xA;SET ct_child.parentaccountid = ct_master.accountid&#xA;FROM Client_Transformed ct_child&#xA;INNER JOIN Client_Hierarchy_Mapping hm_child &#xA;    ON ct_child.source_seq = hm_child.source_seq&#xA;    AND hm_child.record_type = 'CHILD'&#xA;INNER JOIN Client_Hierarchy_Mapping hm_master &#xA;    ON hm_child.parent_seq = hm_master.source_seq&#xA;    AND hm_master.record_type = 'MASTER'&#xA;INNER JOIN Client_Transformed ct_master &#xA;    ON hm_master.pdg_legacyid = ct_master.pdg_legacyid&#xA;    AND ct_master.is_master = 1;&#xA;&#xA;DECLARE @LinkedCount INT = @@ROWCOUNT;&#xA;PRINT 'Child accounts linked to parents: ' + CAST(@LinkedCount AS VARCHAR);&#xA;&#xA;-- Update master balances (sum of children)&#xA;UPDATE ct_master&#xA;SET ct_master.pdg_openingbalance = child_totals.total_balance&#xA;FROM Client_Transformed ct_master&#xA;INNER JOIN (&#xA;    SELECT &#xA;        ct_child.parentaccountid,&#xA;        SUM(ct_child.pdg_openingbalance) as total_balance&#xA;    FROM Client_Transformed ct_child&#xA;    WHERE ct_child.is_child = 1&#xA;    GROUP BY ct_child.parentaccountid&#xA;) child_totals ON ct_master.accountid = child_totals.parentaccountid&#xA;WHERE ct_master.is_master = 1;&#xA;&#xA;DECLARE @MasterBalanceCount INT = @@ROWCOUNT;&#xA;PRINT 'Master balances calculated: ' + CAST(@MasterBalanceCount AS VARCHAR);&#xA;&#xA;-- Verification&#xA;SELECT &#xA;    'Masters' as AccountType,&#xA;    COUNT(*) as Count,&#xA;    SUM(pdg_openingbalance) as TotalBalance&#xA;FROM Client_Transformed&#xA;WHERE is_master = 1&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT &#xA;    'Children' as AccountType,&#xA;    COUNT(*) as Count,&#xA;    SUM(pdg_openingbalance) as TotalBalance&#xA;FROM Client_Transformed&#xA;WHERE is_child = 1&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT &#xA;    'Singles' as AccountType,&#xA;    COUNT(*) as Count,&#xA;    SUM(pdg_openingbalance) as TotalBalance&#xA;FROM Client_Transformed&#xA;WHERE is_single = 1&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT &#xA;    'TOTAL' as AccountType,&#xA;    COUNT(*) as Count,&#xA;    SUM(pdg_openingbalance) as TotalBalance&#xA;FROM Client_Transformed;&#xA;&#xA;PRINT 'Parent-child linking completed successfully!';"
          SQLTask:ServerVersion="9"
          SQLTask:ExtendedLogging="True"
          SQLTask:LocalConnectionForLogging=""
          SQLTask:TaskName=""
          SQLTask:IgnoreDatabasesInNotOnlineState="False" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Validation_Client"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{CDDB6208-4DB9-4F66-AFA5-5FA12BB1B8BE}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Validation_Client"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{81999E50-40D6-45D3-A194-EF12FE479090}"
          SQLTask:BypassPrepare="False"
          SQLTask:SqlStatementSource="USE MetierDartStagingDB;&#xA;GO&#xA;&#xA;PRINT '========================================';&#xA;PRINT 'VALIDATION CHECKS';&#xA;PRINT '========================================';&#xA;&#xA;-- Check 1: Record counts match&#xA;DECLARE @SourceCount INT = (SELECT COUNT(*) FROM Client_Staging);&#xA;DECLARE @MasterCount INT = (SELECT COUNT(*) FROM Client_Transformed WHERE is_master = 1);&#xA;DECLARE @ChildCount INT = (SELECT COUNT(*) FROM Client_Transformed WHERE is_child = 1);&#xA;DECLARE @SingleCount INT = (SELECT COUNT(*) FROM Client_Transformed WHERE is_single = 1);&#xA;DECLARE @TransformedTotal INT = @MasterCount + @ChildCount + @SingleCount;&#xA;&#xA;PRINT '';&#xA;PRINT 'Record Count Validation:';&#xA;PRINT '  Source Records: ' + CAST(@SourceCount AS VARCHAR);&#xA;PRINT '  Master Accounts: ' + CAST(@MasterCount AS VARCHAR);&#xA;PRINT '  Child Accounts: ' + CAST(@ChildCount AS VARCHAR);&#xA;PRINT '  Single Accounts: ' + CAST(@SingleCount AS VARCHAR);&#xA;PRINT '  Transformed Total: ' + CAST(@TransformedTotal AS VARCHAR);&#xA;&#xA;IF @SourceCount + @MasterCount = @TransformedTotal&#xA;    PRINT '  ✅ PASS: All records accounted for';&#xA;ELSE&#xA;    RAISERROR('❌ FAIL: Record count mismatch!', 16, 1);&#xA;&#xA;-- Check 2: Balance preservation&#xA;DECLARE @SourceBalance DECIMAL(18,2) = (SELECT SUM(balance) FROM Client_Staging);&#xA;DECLARE @TransformedBalance DECIMAL(18,2) = (SELECT SUM(pdg_openingbalance) FROM Client_Transformed);&#xA;DECLARE @BalanceDiff DECIMAL(18,2) = ABS(@SourceBalance - @TransformedBalance);&#xA;&#xA;PRINT '';&#xA;PRINT 'Balance Validation:';&#xA;PRINT '  Source Total: $' + CAST(@SourceBalance AS VARCHAR);&#xA;PRINT '  Transformed Total: $' + CAST(@TransformedBalance AS VARCHAR);&#xA;PRINT '  Difference: $' + CAST(@BalanceDiff AS VARCHAR);&#xA;&#xA;IF @BalanceDiff &lt; 0.01&#xA;    PRINT '  ✅ PASS: Balance preserved';&#xA;ELSE&#xA;    RAISERROR('❌ FAIL: Balance mismatch!', 16, 1);&#xA;&#xA;-- Check 3: pdg_legacyid format verification&#xA;DECLARE @InvalidLegacyID INT = (&#xA;    SELECT COUNT(*) &#xA;    FROM Client_Transformed &#xA;    WHERE pdg_legacyid LIKE '%CLIENT%' &#xA;       OR pdg_legacyid LIKE '%M-%'&#xA;       OR pdg_legacyid LIKE '%C-%'&#xA;       OR pdg_legacyid LIKE '%S-%'&#xA;);&#xA;&#xA;PRINT '';&#xA;PRINT 'LegacyID Format Validation:';&#xA;PRINT '  Invalid LegacyIDs (with prefixes): ' + CAST(@InvalidLegacyID AS VARCHAR);&#xA;&#xA;IF @InvalidLegacyID = 0&#xA;    PRINT '  ✅ PASS: All LegacyIDs are exact seq values';&#xA;ELSE&#xA;    RAISERROR('❌ FAIL: LegacyIDs contain prefixes!', 16, 1);&#xA;&#xA;-- Check 4: Parent-child links&#xA;DECLARE @UnlinkedChildren INT = (&#xA;    SELECT COUNT(*) &#xA;    FROM Client_Transformed &#xA;    WHERE is_child = 1 AND parentaccountid IS NULL&#xA;);&#xA;&#xA;PRINT '';&#xA;PRINT 'Parent-Child Link Validation:';&#xA;PRINT '  Unlinked children: ' + CAST(@UnlinkedChildren AS VARCHAR);&#xA;&#xA;IF @UnlinkedChildren = 0&#xA;    PRINT '  ✅ PASS: All children linked to parents';&#xA;ELSE&#xA;    RAISERROR('❌ FAIL: Some children not linked!', 16, 1);&#xA;&#xA;-- Check 5: Duplicate pdg_legacyid&#xA;DECLARE @DuplicateLegacyIDs INT = (&#xA;    SELECT COUNT(*) &#xA;    FROM (&#xA;        SELECT pdg_legacyid, COUNT(*) as cnt&#xA;        FROM Client_Transformed&#xA;        GROUP BY pdg_legacyid&#xA;        HAVING COUNT(*) &gt; 1&#xA;    ) dup&#xA;);&#xA;&#xA;PRINT '';&#xA;PRINT 'Unique LegacyID Validation:';&#xA;PRINT '  Duplicate LegacyIDs: ' + CAST(@DuplicateLegacyIDs AS VARCHAR);&#xA;&#xA;IF @DuplicateLegacyIDs = 0&#xA;    PRINT '  ✅ PASS: All LegacyIDs are unique';&#xA;ELSE&#xA;    RAISERROR('❌ FAIL: Duplicate LegacyIDs found!', 16, 1);&#xA;&#xA;PRINT '';&#xA;PRINT '========================================';&#xA;PRINT 'ALL VALIDATIONS PASSED ✅';&#xA;PRINT '========================================';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
