    <DTS:Executable
      DTS:refId="Package\SQL - Create Hierarchy Mapping"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{AC1F2DE2-771E-4D00-AA97-6391B11ADEE2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Create Hierarchy Mapping"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{96183A0F-012C-4DB9-AB1D-9D98D43DA23A}"
          SQLTask:SqlStatementSource="-- =====================================================================&#xA;-- CREATE HIERARCHY MAPPING - CORRECTED&#xA;-- Natural key design with seq as primary key&#xA;-- NO is_primary_in_group column needed&#xA;-- =====================================================================&#xA;&#xA;USE MetierDartStagingDB;&#xA;GO&#xA;&#xA;PRINT '';&#xA;PRINT '========================================';&#xA;PRINT 'Creating hierarchy mapping with natural key design';&#xA;PRINT '========================================';&#xA;PRINT '';&#xA;&#xA;-- Clear existing mapping&#xA;TRUNCATE TABLE dbo.Client_Hierarchy_Mapping;&#xA;PRINT 'Cleared existing hierarchy mapping';&#xA;PRINT '';&#xA;&#xA;-- =====================================================================&#xA;-- STEP 1: Insert MASTER records (first occurrence of each duplicate name)&#xA;-- =====================================================================&#xA;&#xA;PRINT 'Step 1: Creating MASTER records...';&#xA;&#xA;INSERT INTO dbo.Client_Hierarchy_Mapping (&#xA;    source_seq,&#xA;    customer_name,&#xA;    record_type,&#xA;    parent_seq,&#xA;    master_seq,&#xA;    pdg_legacyid,&#xA;    accountnumber,&#xA;    child_count&#xA;)&#xA;SELECT &#xA;    -- Use the FIRST seq for each duplicate name as the master&#xA;    MIN(seq) as source_seq,&#xA;    name as customer_name,&#xA;    N'MASTER' as record_type,&#xA;    NULL as parent_seq,&#xA;    MIN(seq) as master_seq,&#xA;    CAST(MIN(seq) AS NVARCHAR(50)) as pdg_legacyid,&#xA;    'M-' + RIGHT('000000' + CAST(MIN(seq) AS VARCHAR), 6) as accountnumber,&#xA;    COUNT(*) - 1 as child_count  -- Number of children (total - 1 for master itself)&#xA;FROM dbo.Client_Staging&#xA;GROUP BY name&#xA;HAVING COUNT(*) &gt; 1;  -- Only names that appear more than once&#xA;&#xA;DECLARE @MasterCount INT = @@ROWCOUNT;&#xA;PRINT '  Created ' + CAST(@MasterCount AS VARCHAR) + ' MASTER records';&#xA;PRINT '';&#xA;&#xA;-- =====================================================================&#xA;-- STEP 2: Insert CHILD records (other occurrences of duplicate names)&#xA;-- =====================================================================&#xA;&#xA;PRINT 'Step 2: Creating CHILD records...';&#xA;&#xA;INSERT INTO dbo.Client_Hierarchy_Mapping (&#xA;    source_seq,&#xA;    customer_name,&#xA;    record_type,&#xA;    parent_seq,&#xA;    master_seq,&#xA;    pdg_legacyid,&#xA;    accountnumber,&#xA;    child_count&#xA;)&#xA;SELECT &#xA;    cs.seq as source_seq,&#xA;    cs.name as customer_name,&#xA;    N'CHILD' as record_type,&#xA;    -- Parent is the master (first seq of this name)&#xA;    (SELECT MIN(seq) FROM Client_Staging WHERE name = cs.name) as parent_seq,&#xA;    -- Master_seq also points to the master&#xA;    (SELECT MIN(seq) FROM Client_Staging WHERE name = cs.name) as master_seq,&#xA;    CAST(cs.seq AS NVARCHAR(50)) as pdg_legacyid,&#xA;    'C-' + RIGHT('000000' + CAST(cs.seq AS VARCHAR), 6) as accountnumber,&#xA;    0 as child_count&#xA;FROM dbo.Client_Staging cs&#xA;WHERE EXISTS (&#xA;    -- Only if this name appears more than once&#xA;    SELECT 1 &#xA;    FROM Client_Staging &#xA;    WHERE name = cs.name &#xA;    GROUP BY name &#xA;    HAVING COUNT(*) &gt; 1&#xA;)&#xA;AND cs.seq &gt; (&#xA;    -- Only if this is NOT the first occurrence (not the master)&#xA;    SELECT MIN(seq) &#xA;    FROM Client_Staging &#xA;    WHERE name = cs.name&#xA;);&#xA;&#xA;DECLARE @ChildCount INT = @@ROWCOUNT;&#xA;PRINT '  Created ' + CAST(@ChildCount AS VARCHAR) + ' CHILD records';&#xA;PRINT '';&#xA;&#xA;-- =====================================================================&#xA;-- STEP 3: Insert SINGLE records (unique names)&#xA;-- =====================================================================&#xA;&#xA;PRINT 'Step 3: Creating SINGLE records...';&#xA;&#xA;INSERT INTO dbo.Client_Hierarchy_Mapping (&#xA;    source_seq,&#xA;    customer_name,&#xA;    record_type,&#xA;    parent_seq,&#xA;    master_seq,&#xA;    pdg_legacyid,&#xA;    accountnumber,&#xA;    child_count&#xA;)&#xA;SELECT &#xA;    seq as source_seq,&#xA;    name as customer_name,&#xA;    N'SINGLE' as record_type,&#xA;    NULL as parent_seq,&#xA;    seq as master_seq,  -- Single records reference themselves&#xA;    CAST(seq AS NVARCHAR(50)) as pdg_legacyid,&#xA;    'S-' + RIGHT('000000' + CAST(seq AS VARCHAR), 6) as accountnumber,&#xA;    0 as child_count&#xA;FROM dbo.Client_Staging cs&#xA;WHERE NOT EXISTS (&#xA;    -- Only names that appear exactly once&#xA;    SELECT 1 &#xA;    FROM Client_Staging &#xA;    WHERE name = cs.name &#xA;    GROUP BY name &#xA;    HAVING COUNT(*) &gt; 1&#xA;);&#xA;&#xA;DECLARE @SingleCount INT = @@ROWCOUNT;&#xA;PRINT '  Created ' + CAST(@SingleCount AS VARCHAR) + ' SINGLE records';&#xA;PRINT '';&#xA;&#xA;-- =====================================================================&#xA;-- VERIFICATION&#xA;-- =====================================================================&#xA;&#xA;PRINT '========================================';&#xA;PRINT 'HIERARCHY MAPPING VERIFICATION';&#xA;PRINT '========================================';&#xA;PRINT '';&#xA;&#xA;DECLARE @TotalMapped INT = (SELECT COUNT(*) FROM Client_Hierarchy_Mapping);&#xA;DECLARE @SourceTotal INT = (SELECT COUNT(*) FROM Client_Staging);&#xA;&#xA;PRINT 'Record counts:';&#xA;PRINT '  Source records:      ' + CAST(@SourceTotal AS VARCHAR);&#xA;PRINT '  Mapped records:      ' + CAST(@TotalMapped AS VARCHAR);&#xA;PRINT '  - Masters:           ' + CAST(@MasterCount AS VARCHAR);&#xA;PRINT '  - Children:          ' + CAST(@ChildCount AS VARCHAR);&#xA;PRINT '  - Singles:           ' + CAST(@SingleCount AS VARCHAR);&#xA;PRINT '';&#xA;&#xA;IF @TotalMapped = @SourceTotal&#xA;    PRINT '✅ SUCCESS: All records mapped!';&#xA;ELSE&#xA;BEGIN&#xA;    PRINT '❌ ERROR: Record count mismatch!';&#xA;    RAISERROR('Hierarchy mapping failed - record count mismatch', 16, 1);&#xA;END&#xA;&#xA;PRINT '';&#xA;&#xA;-- Show distribution&#xA;PRINT 'Record type distribution:';&#xA;SELECT &#xA;    record_type,&#xA;    COUNT(*) as count,&#xA;    CAST(COUNT(*) * 100.0 / @TotalMapped AS DECIMAL(5,2)) as percentage&#xA;FROM Client_Hierarchy_Mapping&#xA;GROUP BY record_type&#xA;ORDER BY &#xA;    CASE record_type &#xA;        WHEN N'MASTER' THEN 1 &#xA;        WHEN N'CHILD' THEN 2 &#xA;        WHEN N'SINGLE' THEN 3 &#xA;    END;&#xA;&#xA;PRINT '';&#xA;&#xA;-- Sample master-child relationships&#xA;PRINT 'Sample master-child relationships:';&#xA;SELECT TOP 5&#xA;    m.source_seq as master_seq,&#xA;    m.customer_name,&#xA;    m.accountnumber as master_accountnumber,&#xA;    COUNT(c.source_seq) as child_count&#xA;FROM Client_Hierarchy_Mapping m&#xA;LEFT JOIN Client_Hierarchy_Mapping c ON m.source_seq = c.parent_seq&#xA;WHERE m.record_type = N'MASTER'&#xA;GROUP BY m.source_seq, m.customer_name, m.accountnumber&#xA;ORDER BY COUNT(c.source_seq) DESC;&#xA;&#xA;PRINT '';&#xA;PRINT '========================================';&#xA;PRINT 'Hierarchy mapping complete!';&#xA;PRINT '========================================';&#xA;PRINT '';&#xA;&#xA;GO&#xA;&#xA;/*&#xA;=======================================================================&#xA;EXPLANATION OF LOGIC&#xA;=======================================================================&#xA;&#xA;MASTER Records:&#xA;───────────────&#xA;- First occurrence (MIN(seq)) of each duplicate name&#xA;- Example: &quot;ABBOUD ZEINA&quot; appears 3 times (seq: 742, 1360, 1361)&#xA;  → Master is seq 742 (the first one)&#xA;- AccountNumber: M-000742&#xA;- pdg_legacyid: &quot;742&quot;&#xA;- parent_seq: NULL (masters have no parent)&#xA;- child_count: 2 (has 2 children: 1360 and 1361)&#xA;&#xA;CHILD Records:&#xA;──────────────&#xA;- All OTHER occurrences of duplicate names&#xA;- Example: &quot;ABBOUD ZEINA&quot; seq 1360 and 1361&#xA;- AccountNumber: C-001360, C-001361&#xA;- pdg_legacyid: &quot;1360&quot;, &quot;1361&quot;&#xA;- parent_seq: 742 (points to master)&#xA;- child_count: 0 (children don't have children)&#xA;&#xA;SINGLE Records:&#xA;───────────────&#xA;- Names that appear only once&#xA;- AccountNumber: S-000001&#xA;- pdg_legacyid: &quot;1&quot;&#xA;- parent_seq: NULL (singles have no parent)&#xA;- child_count: 0 (singles don't have children)&#xA;&#xA;AccountNumber Prefixes:&#xA;───────────────────────&#xA;M- = Master account&#xA;C- = Child account&#xA;S- = Single account&#xA;&#xA;Natural Key Design:&#xA;───────────────────&#xA;- seq from source is preserved as primary key&#xA;- No GUIDs needed&#xA;- pdg_legacyid = CAST(seq AS NVARCHAR)&#xA;- Enables idempotent UPSERT operations&#xA;&#xA;=======================================================================&#xA;EXPECTED OUTPUT&#xA;=======================================================================&#xA;&#xA;For 12,061 records with duplicates:&#xA;&#xA;Record counts:&#xA;  Source records:      12,061&#xA;  Mapped records:      12,061&#xA;  - Masters:           235&#xA;  - Children:          275&#xA;  - Singles:           11,551&#xA;&#xA;Record type distribution:&#xA;MASTER     235    1.95%&#xA;CHILD      275    2.28%&#xA;SINGLE   11,551  95.77%&#xA;&#xA;✅ SUCCESS: All records mapped!&#xA;&#xA;=======================================================================&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL - Extract Unique Contacts"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{44c15349-0b50-4832-8989-84fc027114f8}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Extract Unique Contacts"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{96183A0F-012C-4DB9-AB1D-9D98D43DA23A}"
          SQLTask:SqlStatementSource="-- =====================================================================&#xA;-- EXTRACT UNIQUE CONTACTS FROM CLIENT_TRANSFORMED&#xA;-- =====================================================================&#xA;&#xA;USE MetierDartStagingDB;&#xA;GO&#xA;&#xA;PRINT '';&#xA;PRINT '========================================';&#xA;PRINT 'EXTRACTING UNIQUE CONTACTS';&#xA;PRINT '========================================';&#xA;PRINT '';&#xA;&#xA;-- Clear existing data&#xA;TRUNCATE TABLE dbo.Contact_Staging;&#xA;PRINT '✓ Cleared Contact_Staging';&#xA;PRINT '';&#xA;&#xA;-- =====================================================================&#xA;-- Insert unique contact names with statistics&#xA;-- =====================================================================&#xA;&#xA;PRINT 'Extracting unique contacts...';&#xA;&#xA;INSERT INTO dbo.Contact_Staging (&#xA;    fullname,&#xA;    primary_account_seq,&#xA;    primary_account_name,&#xA;    sample_phone,&#xA;    sample_email,&#xA;    account_count&#xA;)&#xA;SELECT &#xA;    pdg_primarycontactname as fullname,&#xA;    MIN(seq) as primary_account_seq,&#xA;    MIN(name) as primary_account_name,&#xA;    MAX(telephone1) as sample_phone,&#xA;    MAX(emailaddress1) as sample_email,&#xA;    COUNT(*) as account_count&#xA;FROM dbo.Client_Transformed&#xA;WHERE pdg_primarycontactname IS NOT NULL&#xA;  AND LTRIM(RTRIM(pdg_primarycontactname)) != ''&#xA;GROUP BY pdg_primarycontactname;&#xA;&#xA;DECLARE @ContactCount INT = @@ROWCOUNT;&#xA;PRINT '✓ Extracted ' + CAST(@ContactCount AS VARCHAR) + ' unique contacts';&#xA;PRINT '';&#xA;&#xA;-- =====================================================================&#xA;-- Parse names into firstname/lastname&#xA;-- =====================================================================&#xA;&#xA;PRINT 'Parsing contact names...';&#xA;&#xA;UPDATE dbo.Contact_Staging&#xA;SET &#xA;    -- If name has space, split on first space&#xA;    firstname = CASE &#xA;        WHEN CHARINDEX(' ', fullname) &gt; 0 &#xA;        THEN LTRIM(RTRIM(LEFT(fullname, CHARINDEX(' ', fullname) - 1)))&#xA;        ELSE LTRIM(RTRIM(fullname))  -- Single word = firstname&#xA;    END,&#xA;    &#xA;    lastname = CASE &#xA;        WHEN CHARINDEX(' ', fullname) &gt; 0 &#xA;        THEN LTRIM(RTRIM(SUBSTRING(fullname, CHARINDEX(' ', fullname) + 1, 200)))&#xA;        ELSE ''  -- Single word = no lastname&#xA;    END,&#xA;    &#xA;    -- Flag single-word names&#xA;    is_single_word = CASE &#xA;        WHEN CHARINDEX(' ', fullname) = 0 THEN 1 &#xA;        ELSE 0 &#xA;    END;&#xA;&#xA;PRINT '✓ Parsed names into first/last';&#xA;PRINT '';&#xA;&#xA;-- =====================================================================&#xA;-- Flag contacts needing review&#xA;-- =====================================================================&#xA;&#xA;PRINT 'Flagging contacts for review...';&#xA;&#xA;UPDATE dbo.Contact_Staging&#xA;SET needs_review = 1&#xA;WHERE &#xA;    -- Single word names&#xA;    is_single_word = 1&#xA;    -- Very short names (initials?)&#xA;    OR LEN(fullname) &lt;= 3&#xA;    -- Very long names&#xA;    OR LEN(fullname) &gt; 50&#xA;    -- Still contains numbers (cleaning failed)&#xA;    OR fullname LIKE '%[0-9]%'&#xA;    -- Still contains @ (cleaning failed)&#xA;    OR fullname LIKE '%@%';&#xA;&#xA;DECLARE @NeedsReview INT = (SELECT COUNT(*) FROM Contact_Staging WHERE needs_review = 1);&#xA;PRINT '✓ Flagged ' + CAST(@NeedsReview AS VARCHAR) + ' contacts for review';&#xA;PRINT '';&#xA;&#xA;-- =====================================================================&#xA;-- Create legacy IDs for alternate key&#xA;-- =====================================================================&#xA;&#xA;PRINT 'Creating legacy contact IDs...';&#xA;&#xA;-- Clear existing mapping&#xA;TRUNCATE TABLE dbo.Contact_Mapping;&#xA;&#xA;-- Insert into mapping table with legacy IDs&#xA;INSERT INTO dbo.Contact_Mapping (&#xA;    contact_staging_id,&#xA;    fullname,&#xA;    pdg_contactlegacyid&#xA;)&#xA;SELECT &#xA;    contact_id,&#xA;    fullname,&#xA;    'CONTACT-' + RIGHT('00000' + CAST(contact_id AS VARCHAR), 5) as pdg_contactlegacyid&#xA;FROM dbo.Contact_Staging;&#xA;&#xA;PRINT '✓ Created legacy IDs for ' + CAST(@ContactCount AS VARCHAR) + ' contacts';&#xA;PRINT '';&#xA;&#xA;-- =====================================================================&#xA;-- Summary Report&#xA;-- =====================================================================&#xA;&#xA;PRINT '========================================';&#xA;PRINT 'CONTACT EXTRACTION SUMMARY';&#xA;PRINT '========================================';&#xA;PRINT '';&#xA;&#xA;SELECT &#xA;    @ContactCount as total_contacts,&#xA;    (SELECT COUNT(*) FROM Contact_Staging WHERE is_single_word = 1) as single_word_names,&#xA;    @NeedsReview as needs_review,&#xA;    (SELECT SUM(account_count) FROM Contact_Staging) as total_account_links;&#xA;&#xA;PRINT '';&#xA;PRINT 'Top 10 contacts by account count:';&#xA;SELECT TOP 10&#xA;    fullname,&#xA;    firstname,&#xA;    lastname,&#xA;    account_count,&#xA;    CASE WHEN needs_review = 1 THEN 'Yes' ELSE 'No' END as needs_review&#xA;FROM Contact_Staging&#xA;ORDER BY account_count DESC;&#xA;&#xA;PRINT '';&#xA;PRINT '========================================';&#xA;PRINT '✅ Contact extraction complete!';&#xA;PRINT '========================================';&#xA;PRINT '';&#xA;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL - Link Parent-Child"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{5FCC30B1-E8EC-4D80-88AE-3373A21B9D26}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Link Parent-Child"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{96183A0F-012C-4DB9-AB1D-9D98D43DA23A}"
          SQLTask:SqlStatementSource="-- Direct copy of parent_seq value&#xA;UPDATE child&#xA;SET &#xA;    child.parent_seq = hm.parent_seq,              -- ✅ Simple copy!&#xA;    child.pdg_parentlegacyid = CAST(hm.parent_seq AS NVARCHAR)&#xA;FROM Client_Transformed child&#xA;INNER JOIN Client_Hierarchy_Mapping hm &#xA;    ON child.seq = hm.source_seq                   -- ✅ Direct match on seq&#xA;WHERE hm.parent_seq IS NOT NULL&#xA;  AND child.is_child = 1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL - UPSERT Staging to Final"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{ccb13143-7f31-4ad3-b108-55e68bcf68c2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - UPSERT Staging to Final"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{96183A0F-012C-4DB9-AB1D-9D98D43DA23A}"
          SQLTask:SqlStatementSource="-- =====================================================================&#xA;-- UPDATED UPSERT SQL - INCLUDES ALL NEW FIELDS&#xA;-- Discount, Credit Hold, Payment Terms, Contact, Salesman&#xA;-- =====================================================================&#xA;&#xA;USE MetierDartStagingDB;&#xA;GO&#xA;&#xA;PRINT 'Starting UPSERT from staging to final...';&#xA;&#xA;MERGE dbo.Client_Transformed AS target&#xA;USING dbo.Client_Transformed_Staging AS source&#xA;ON target.seq = source.seq&#xA;&#xA;-- =====================================================================&#xA;-- UPDATE EXISTING RECORDS&#xA;-- =====================================================================&#xA;WHEN MATCHED THEN&#xA;    UPDATE SET&#xA;        -- Identifiers&#xA;        target.pdg_legacyid = source.pdg_legacyid,&#xA;        target.accountnumber = source.accountnumber,&#xA;        target.name = source.name,&#xA;        target.description = source.description,&#xA;        &#xA;        -- Address&#xA;        target.address1_line1 = source.address1_line1,&#xA;        target.address1_line2 = source.address1_line2,&#xA;        &#xA;        -- Contact (Enhanced)&#xA;        target.telephone1 = source.telephone1,&#xA;        target.telephone2 = source.telephone2,&#xA;        target.fax = source.fax,&#xA;        target.emailaddress1 = source.emailaddress1,&#xA;        &#xA;        -- Financial&#xA;        target.pdg_openingbalance = source.pdg_openingbalance,&#xA;        target.pdg_creditlimit = source.pdg_creditlimit,&#xA;        target.pdg_discount = source.pdg_discount,                      -- ✅ NEW&#xA;        target.pdg_creditonhold = source.pdg_creditonhold,              -- ✅ NEW&#xA;        target.pdg_paymenttermsdays = source.pdg_paymenttermsdays,      -- ✅ NEW&#xA;        &#xA;        -- Hierarchy&#xA;        target.is_master = source.is_master,&#xA;        target.is_child = source.is_child,&#xA;        target.is_single = source.is_single,&#xA;        target.parent_seq = source.parent_seq,&#xA;        target.pdg_parentlegacyid = source.pdg_parentlegacyid,&#xA;        &#xA;        -- Lookups&#xA;        target.pdg_category = source.pdg_category,&#xA;        target.pdg_zoneidstring = source.pdg_zoneidstring,&#xA;        target.pdg_salesmanidstring = source.pdg_salesmanidstring,      -- ✅ NEW&#xA;        target.pdg_primarycontactname = source.pdg_primarycontactname,  -- ✅ NEW&#xA;        &#xA;        -- Data Quality&#xA;        target.needs_address = source.needs_address,&#xA;        target.needs_email = source.needs_email,&#xA;        target.needs_phone = source.needs_phone,&#xA;        &#xA;        -- Source Reference&#xA;        target.source_seq = source.source_seq,&#xA;        &#xA;        -- Audit&#xA;        target.modified_date = GETDATE()&#xA;&#xA;-- =====================================================================&#xA;-- INSERT NEW RECORDS&#xA;-- =====================================================================&#xA;WHEN NOT MATCHED THEN&#xA;    INSERT (&#xA;        -- Identifiers&#xA;        seq,&#xA;        pdg_legacyid,&#xA;        accountnumber,&#xA;        name,&#xA;        description,&#xA;        &#xA;        -- Address&#xA;        address1_line1,&#xA;        address1_line2,&#xA;        &#xA;        -- Contact&#xA;        telephone1,&#xA;        telephone2,&#xA;        fax,&#xA;        emailaddress1,&#xA;        &#xA;        -- Financial&#xA;        pdg_openingbalance,&#xA;        pdg_creditlimit,&#xA;        pdg_discount,                   -- ✅ NEW&#xA;        pdg_creditonhold,               -- ✅ NEW&#xA;        pdg_paymenttermsdays,           -- ✅ NEW&#xA;        &#xA;        -- Hierarchy&#xA;        is_master,&#xA;        is_child,&#xA;        is_single,&#xA;        parent_seq,&#xA;        pdg_parentlegacyid,&#xA;        &#xA;        -- Lookups&#xA;        pdg_category,&#xA;        pdg_zoneidstring,&#xA;        pdg_salesmanidstring,           -- ✅ NEW&#xA;        pdg_primarycontactname,         -- ✅ NEW&#xA;        &#xA;        -- Data Quality&#xA;        needs_address,&#xA;        needs_email,&#xA;        needs_phone,&#xA;        &#xA;        -- Source Reference&#xA;        source_seq,&#xA;        &#xA;        -- Audit&#xA;        created_date,&#xA;        modified_date&#xA;    )&#xA;    VALUES (&#xA;        -- Identifiers&#xA;        source.seq,&#xA;        source.pdg_legacyid,&#xA;        source.accountnumber,&#xA;        source.name,&#xA;        source.description,&#xA;        &#xA;        -- Address&#xA;        source.address1_line1,&#xA;        source.address1_line2,&#xA;        &#xA;        -- Contact&#xA;        source.telephone1,&#xA;        source.telephone2,&#xA;        source.fax,&#xA;        source.emailaddress1,&#xA;        &#xA;        -- Financial&#xA;        source.pdg_openingbalance,&#xA;        source.pdg_creditlimit,&#xA;        source.pdg_discount,                    -- ✅ NEW&#xA;        source.pdg_creditonhold,                -- ✅ NEW&#xA;        source.pdg_paymenttermsdays,            -- ✅ NEW&#xA;        &#xA;        -- Hierarchy&#xA;        source.is_master,&#xA;        source.is_child,&#xA;        source.is_single,&#xA;        source.parent_seq,&#xA;        source.pdg_parentlegacyid,&#xA;        &#xA;        -- Lookups&#xA;        source.pdg_category,&#xA;        source.pdg_zoneidstring,&#xA;        source.pdg_salesmanidstring,            -- ✅ NEW&#xA;        source.pdg_primarycontactname,          -- ✅ NEW&#xA;        &#xA;        -- Data Quality&#xA;        source.needs_address,&#xA;        source.needs_email,&#xA;        source.needs_phone,&#xA;        &#xA;        -- Source Reference&#xA;        source.source_seq,&#xA;        &#xA;        -- Audit&#xA;        GETDATE(),&#xA;        GETDATE()&#xA;    );&#xA;&#xA;DECLARE @inserted INT = @@ROWCOUNT;&#xA;PRINT 'UPSERT complete: ' + CAST(@inserted AS VARCHAR(10)) + ' rows affected';&#xA;&#xA;-- Clear staging table&#xA;TRUNCATE TABLE dbo.Client_Transformed_Staging;&#xA;PRINT 'Staging table cleared';&#xA;&#xA;GO&#xA;&#xA;/*&#xA;=======================================================================&#xA;SUMMARY OF CHANGES&#xA;=======================================================================&#xA;&#xA;NEW FIELDS ADDED TO UPSERT:&#xA;────────────────────────────&#xA;&#xA;1. pdg_discount&#xA;   - Discount percentage&#xA;   - DECIMAL(5,2)&#xA;&#xA;2. pdg_creditonhold&#xA;   - Credit on hold flag&#xA;   - BIT&#xA;&#xA;3. pdg_paymenttermsdays&#xA;   - Payment terms in days&#xA;   - INT (nullable)&#xA;&#xA;4. pdg_salesmanidstring&#xA;   - Salesman identifier&#xA;   - NVARCHAR(50)&#xA;&#xA;5. pdg_primarycontactname&#xA;   - Primary contact name&#xA;   - NVARCHAR(200)&#xA;&#xA;ALSO ADDED (if not already present):&#xA;─────────────────────────────────────&#xA;&#xA;- needs_email&#xA;- needs_phone&#xA;&#xA;FIELDS INCLUDED:&#xA;────────────────&#xA;&#xA;UPDATE: 33 fields&#xA;INSERT: 31 fields + 2 audit fields&#xA;&#xA;=======================================================================&#xA;VERIFICATION QUERY&#xA;=======================================================================&#xA;&#xA;After running UPSERT, verify new fields populated:&#xA;&#xA;SELECT TOP 10&#xA;    seq,&#xA;    name,&#xA;    pdg_discount,&#xA;    pdg_creditonhold,&#xA;    pdg_paymenttermsdays,&#xA;    pdg_salesmanidstring,&#xA;    pdg_primarycontactname&#xA;FROM Client_Transformed&#xA;WHERE pdg_discount IS NOT NULL&#xA;   OR pdg_primarycontactname IS NOT NULL;&#xA;&#xA;Expected:&#xA;- pdg_discount: Values like 5.50, 10.00&#xA;- pdg_creditonhold: 0 or 1&#xA;- pdg_paymenttermsdays: NULL or integer values&#xA;- pdg_salesmanidstring: Salesman IDs&#xA;- pdg_primarycontactname: Contact names&#xA;&#xA;=======================================================================&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL - Validation &amp; Summary"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{33E212A1-43F1-491F-9165-256F26B9E800}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Validation &amp; Summary"
      DTS:ThreadHint="2">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{96183A0F-012C-4DB9-AB1D-9D98D43DA23A}"
          SQLTask:BypassPrepare="False"
          SQLTask:SqlStatementSource="-- =====================================================================&#xA;-- UPDATED VALIDATION - WITH NEW FIELDS&#xA;-- Includes: Discount, Credit Hold, Payment Terms, Contact, Salesman&#xA;-- =====================================================================&#xA;&#xA;USE MetierDartStagingDB;&#xA;GO&#xA;&#xA;PRINT '';&#xA;PRINT '========================================';&#xA;PRINT 'MIGRATION VALIDATION SUMMARY';&#xA;PRINT 'Design: Original balances preserved';&#xA;PRINT '========================================';&#xA;PRINT '';&#xA;&#xA;-- CHECK 1: Record Count Validation&#xA;DECLARE @SourceCount INT = (SELECT COUNT(*) FROM Client_Staging);&#xA;DECLARE @TransformedCount INT = (SELECT COUNT(*) FROM Client_Transformed);&#xA;&#xA;PRINT '1. RECORD COUNT:';&#xA;PRINT '   Source records:      ' + CAST(@SourceCount AS VARCHAR);&#xA;PRINT '   Transformed records: ' + CAST(@TransformedCount AS VARCHAR);&#xA;&#xA;IF @SourceCount = @TransformedCount&#xA;    PRINT '   ✅ PASS: Record counts match!';&#xA;ELSE&#xA;BEGIN&#xA;    PRINT '   ❌ FAIL: Record count mismatch!';&#xA;    RAISERROR('Record count validation failed!', 16, 1);&#xA;END&#xA;&#xA;PRINT '';&#xA;&#xA;-- CHECK 2: Balance Validation - ALL Records Keep Original Balance&#xA;PRINT '2. BALANCE VALIDATION:';&#xA;&#xA;DECLARE @SourceBalance DECIMAL(18,2) = (&#xA;    SELECT ISNULL(SUM(balance), 0) FROM Client_Staging&#xA;);&#xA;DECLARE @TransformedBalance DECIMAL(18,2) = (&#xA;    SELECT ISNULL(SUM(pdg_openingbalance), 0) FROM Client_Transformed&#xA;);&#xA;DECLARE @BalanceDifference DECIMAL(18,2) = ABS(@SourceBalance - @TransformedBalance);&#xA;&#xA;PRINT '   Source balance:       $' + CAST(@SourceBalance AS VARCHAR);&#xA;PRINT '   Transformed balance:  $' + CAST(@TransformedBalance AS VARCHAR);&#xA;PRINT '   Difference:           $' + CAST(@BalanceDifference AS VARCHAR);&#xA;&#xA;IF @BalanceDifference &lt; 1.00&#xA;    PRINT '   ✅ PASS: All balances preserved exactly!';&#xA;ELSE&#xA;BEGIN&#xA;    PRINT '   ❌ FAIL: Balance mismatch exceeds tolerance!';&#xA;    DECLARE @BalanceErrorMsg NVARCHAR(200) = 'Balance validation failed! Difference: $' + CAST(@BalanceDifference AS NVARCHAR(50));&#xA;    RAISERROR(@BalanceErrorMsg, 16, 1);&#xA;END&#xA;&#xA;PRINT '';&#xA;PRINT '   Balance by record type:';&#xA;SELECT &#xA;    CASE &#xA;        WHEN is_master = 1 THEN 'MASTER'&#xA;        WHEN is_child = 1 THEN 'CHILD'&#xA;        WHEN is_single = 1 THEN 'SINGLE'&#xA;    END as record_type,&#xA;    COUNT(*) as count,&#xA;    SUM(pdg_openingbalance) as total_balance,&#xA;    AVG(pdg_openingbalance) as avg_balance,&#xA;    MIN(pdg_openingbalance) as min_balance,&#xA;    MAX(pdg_openingbalance) as max_balance&#xA;FROM Client_Transformed&#xA;GROUP BY is_master, is_child, is_single&#xA;ORDER BY is_master DESC, is_child DESC;&#xA;&#xA;PRINT '';&#xA;&#xA;-- CHECK 3: Record Type Distribution&#xA;PRINT '3. RECORD TYPE DISTRIBUTION:';&#xA;SELECT &#xA;    CASE &#xA;        WHEN is_master = 1 THEN 'MASTER (primary duplicates)'&#xA;        WHEN is_child = 1 THEN 'CHILD (other duplicates)'&#xA;        WHEN is_single = 1 THEN 'SINGLE (unique names)'&#xA;        ELSE 'INVALID'&#xA;    END as record_type,&#xA;    COUNT(*) as count,&#xA;    CAST(COUNT(*) * 100.0 / @TransformedCount AS DECIMAL(5,2)) as percentage&#xA;FROM Client_Transformed&#xA;GROUP BY is_master, is_child, is_single&#xA;ORDER BY &#xA;    CASE &#xA;        WHEN is_master = 1 THEN 1&#xA;        WHEN is_child = 1 THEN 2&#xA;        WHEN is_single = 1 THEN 3&#xA;        ELSE 4&#xA;    END;&#xA;&#xA;PRINT '';&#xA;&#xA;-- CHECK 4: Parent-Child Linkage&#xA;PRINT '4. PARENT-CHILD LINKAGE:';&#xA;&#xA;DECLARE @MasterCount INT = (SELECT COUNT(*) FROM Client_Transformed WHERE is_master = 1);&#xA;DECLARE @ChildCount INT = (SELECT COUNT(*) FROM Client_Transformed WHERE is_child = 1);&#xA;DECLARE @LinkedChildren INT = (&#xA;    SELECT COUNT(*) FROM Client_Transformed WHERE is_child = 1 AND parent_seq IS NOT NULL&#xA;);&#xA;DECLARE @OrphanChildren INT = (&#xA;    SELECT COUNT(*) FROM Client_Transformed WHERE is_child = 1 AND parent_seq IS NULL&#xA;);&#xA;&#xA;PRINT '   Master accounts:    ' + CAST(@MasterCount AS VARCHAR);&#xA;PRINT '   Child accounts:     ' + CAST(@ChildCount AS VARCHAR);&#xA;PRINT '   Linked children:    ' + CAST(@LinkedChildren AS VARCHAR);&#xA;PRINT '   Orphan children:    ' + CAST(@OrphanChildren AS VARCHAR);&#xA;&#xA;IF @OrphanChildren = 0&#xA;    PRINT '   ✅ PASS: All children linked to masters!';&#xA;ELSE&#xA;BEGIN&#xA;    PRINT '   ❌ FAIL: Found orphaned children!';&#xA;    RAISERROR('Parent-child linkage validation failed!', 16, 1);&#xA;END&#xA;&#xA;PRINT '';&#xA;PRINT '   Sample master-child groups (with original balances):';&#xA;SELECT TOP 5&#xA;    master.seq as master_seq,&#xA;    master.pdg_legacyid as master_id,&#xA;    master.name as master_name,&#xA;    master.pdg_openingbalance as master_original_balance,&#xA;    COUNT(child.seq) as child_count,&#xA;    SUM(child.pdg_openingbalance) as children_balance_total,&#xA;    master.pdg_openingbalance + SUM(child.pdg_openingbalance) as group_total_balance&#xA;FROM Client_Transformed master&#xA;LEFT JOIN Client_Transformed child ON master.seq = child.parent_seq&#xA;WHERE master.is_master = 1&#xA;GROUP BY master.seq, master.pdg_legacyid, master.name, master.pdg_openingbalance&#xA;ORDER BY COUNT(child.seq) DESC;&#xA;&#xA;PRINT '';&#xA;PRINT '   Note: Master balances will be aggregated in Dataverse using Rollup Fields';&#xA;PRINT '';&#xA;&#xA;-- CHECK 5: Legacy ID Uniqueness&#xA;PRINT '5. LEGACY ID VALIDATION:';&#xA;&#xA;DECLARE @DuplicateLegacyIDs INT = (&#xA;    SELECT COUNT(*) FROM (&#xA;        SELECT pdg_legacyid&#xA;        FROM Client_Transformed&#xA;        GROUP BY pdg_legacyid&#xA;        HAVING COUNT(*) &gt; 1&#xA;    ) dup&#xA;);&#xA;&#xA;PRINT '   Duplicate legacy IDs: ' + CAST(@DuplicateLegacyIDs AS VARCHAR);&#xA;&#xA;IF @DuplicateLegacyIDs = 0&#xA;    PRINT '   ✅ PASS: All legacy IDs are unique!';&#xA;ELSE&#xA;BEGIN&#xA;    PRINT '   ❌ FAIL: Found duplicate legacy IDs!';&#xA;    PRINT '';&#xA;    PRINT '   Duplicate legacy IDs found:';&#xA;    SELECT TOP 5 pdg_legacyid, COUNT(*) as duplicate_count&#xA;    FROM Client_Transformed&#xA;    GROUP BY pdg_legacyid&#xA;    HAVING COUNT(*) &gt; 1;&#xA;    RAISERROR('Legacy ID uniqueness validation failed!', 16, 1);&#xA;END&#xA;&#xA;PRINT '';&#xA;&#xA;-- CHECK 6: Data Quality Summary&#xA;PRINT '6. DATA QUALITY:';&#xA;&#xA;DECLARE @WithAddress INT = (SELECT COUNT(*) FROM Client_Transformed WHERE address1_line1 IS NOT NULL OR address1_line2 IS NOT NULL);&#xA;DECLARE @WithPhone INT = (SELECT COUNT(*) FROM Client_Transformed WHERE telephone1 IS NOT NULL OR telephone2 IS NOT NULL);&#xA;DECLARE @WithEmail INT = (SELECT COUNT(*) FROM Client_Transformed WHERE emailaddress1 IS NOT NULL);&#xA;DECLARE @WithCategory INT = (SELECT COUNT(*) FROM Client_Transformed WHERE pdg_category IS NOT NULL);&#xA;DECLARE @WithCreditLimit INT = (SELECT COUNT(*) FROM Client_Transformed WHERE pdg_creditlimit IS NOT NULL);&#xA;&#xA;PRINT '   Records with address:      ' + CAST(@WithAddress AS VARCHAR) + ' (' + CAST(CAST(@WithAddress * 100.0 / @TransformedCount AS DECIMAL(5,2)) AS VARCHAR) + '%)';&#xA;PRINT '   Records with phone:        ' + CAST(@WithPhone AS VARCHAR) + ' (' + CAST(CAST(@WithPhone * 100.0 / @TransformedCount AS DECIMAL(5,2)) AS VARCHAR) + '%)';&#xA;PRINT '   Records with email:        ' + CAST(@WithEmail AS VARCHAR) + ' (' + CAST(CAST(@WithEmail * 100.0 / @TransformedCount AS DECIMAL(5,2)) AS VARCHAR) + '%)';&#xA;PRINT '   Records with category:     ' + CAST(@WithCategory AS VARCHAR) + ' (' + CAST(CAST(@WithCategory * 100.0 / @TransformedCount AS DECIMAL(5,2)) AS VARCHAR) + '%)';&#xA;PRINT '   Records with credit limit: ' + CAST(@WithCreditLimit AS VARCHAR) + ' (' + CAST(CAST(@WithCreditLimit * 100.0 / @TransformedCount AS DECIMAL(5,2)) AS VARCHAR) + '%)';&#xA;&#xA;PRINT '';&#xA;&#xA;-- =====================================================================&#xA;-- ✅ NEW CHECK 6A: NEW FIELDS VALIDATION&#xA;-- =====================================================================&#xA;PRINT '6A. NEW FIELDS VALIDATION:';&#xA;PRINT '';&#xA;&#xA;-- Discount validation&#xA;DECLARE @WithDiscount INT = (SELECT COUNT(*) FROM Client_Transformed WHERE pdg_discount IS NOT NULL);&#xA;DECLARE @AvgDiscount DECIMAL(5,2) = (SELECT AVG(pdg_discount) FROM Client_Transformed WHERE pdg_discount IS NOT NULL);&#xA;DECLARE @MaxDiscount DECIMAL(5,2) = (SELECT MAX(pdg_discount) FROM Client_Transformed WHERE pdg_discount IS NOT NULL);&#xA;&#xA;PRINT '   DISCOUNT:';&#xA;PRINT '   - Records with discount:   ' + CAST(@WithDiscount AS VARCHAR) + ' (' + CAST(CAST(@WithDiscount * 100.0 / @TransformedCount AS DECIMAL(5,2)) AS VARCHAR) + '%)';&#xA;PRINT '   - Average discount:        ' + CAST(ISNULL(@AvgDiscount, 0) AS VARCHAR) + '%';&#xA;PRINT '   - Maximum discount:        ' + CAST(ISNULL(@MaxDiscount, 0) AS VARCHAR) + '%';&#xA;PRINT '';&#xA;&#xA;-- Credit on hold validation&#xA;DECLARE @OnHoldCount INT = (SELECT COUNT(*) FROM Client_Transformed WHERE pdg_creditonhold = 1);&#xA;DECLARE @NotOnHoldCount INT = (SELECT COUNT(*) FROM Client_Transformed WHERE pdg_creditonhold = 0);&#xA;&#xA;PRINT '   CREDIT ON HOLD:';&#xA;PRINT '   - Accounts on hold:        ' + CAST(@OnHoldCount AS VARCHAR) + ' (' + CAST(CAST(@OnHoldCount * 100.0 / @TransformedCount AS DECIMAL(5,2)) AS VARCHAR) + '%)';&#xA;PRINT '   - Accounts not on hold:    ' + CAST(@NotOnHoldCount AS VARCHAR) + ' (' + CAST(CAST(@NotOnHoldCount * 100.0 / @TransformedCount AS DECIMAL(5,2)) AS VARCHAR) + '%)';&#xA;PRINT '';&#xA;&#xA;-- Payment terms validation&#xA;DECLARE @WithPaymentTerms INT = (SELECT COUNT(*) FROM Client_Transformed WHERE pdg_paymenttermsdays IS NOT NULL);&#xA;DECLARE @AvgPaymentTerms INT = (SELECT AVG(pdg_paymenttermsdays) FROM Client_Transformed WHERE pdg_paymenttermsdays IS NOT NULL);&#xA;&#xA;PRINT '   PAYMENT TERMS:';&#xA;PRINT '   - Records with terms:      ' + CAST(@WithPaymentTerms AS VARCHAR) + ' (' + CAST(CAST(@WithPaymentTerms * 100.0 / @TransformedCount AS DECIMAL(5,2)) AS VARCHAR) + '%)';&#xA;IF @WithPaymentTerms &gt; 0&#xA;    PRINT '   - Average terms (days):    ' + CAST(ISNULL(@AvgPaymentTerms, 0) AS VARCHAR);&#xA;PRINT '';&#xA;&#xA;-- Primary contact validation&#xA;DECLARE @WithContact INT = (&#xA;    SELECT COUNT(*) &#xA;    FROM Client_Transformed &#xA;    WHERE pdg_primarycontactname IS NOT NULL &#xA;      AND LTRIM(RTRIM(pdg_primarycontactname)) != ''&#xA;);&#xA;&#xA;PRINT '   PRIMARY CONTACT:';&#xA;PRINT '   - Records with contact:    ' + CAST(@WithContact AS VARCHAR) + ' (' + CAST(CAST(@WithContact * 100.0 / @TransformedCount AS DECIMAL(5,2)) AS VARCHAR) + '%)';&#xA;PRINT '';&#xA;&#xA;-- Salesman validation&#xA;DECLARE @WithSalesman INT = (&#xA;    SELECT COUNT(*) &#xA;    FROM Client_Transformed &#xA;    WHERE pdg_salesmanidstring IS NOT NULL &#xA;      AND LTRIM(RTRIM(pdg_salesmanidstring)) != ''&#xA;);&#xA;&#xA;PRINT '   SALESMAN:';&#xA;PRINT '   - Records with salesman:   ' + CAST(@WithSalesman AS VARCHAR) + ' (' + CAST(CAST(@WithSalesman * 100.0 / @TransformedCount AS DECIMAL(5,2)) AS VARCHAR) + '%)';&#xA;PRINT '';&#xA;&#xA;-- =====================================================================&#xA;-- ✅ NEW CHECK 6B: PHONE &amp; EMAIL ENHANCEMENT VALIDATION&#xA;-- =====================================================================&#xA;PRINT '6B. DATA ENHANCEMENT VALIDATION:';&#xA;PRINT '';&#xA;&#xA;-- Phone standardization check (international format)&#xA;DECLARE @WithInternationalPhone INT = (&#xA;    SELECT COUNT(*) &#xA;    FROM Client_Transformed &#xA;    WHERE telephone1 LIKE '+%' OR telephone2 LIKE '+%'&#xA;);&#xA;&#xA;PRINT '   PHONE STANDARDIZATION:';&#xA;PRINT '   - International format (+): ' + CAST(@WithInternationalPhone AS VARCHAR);&#xA;PRINT '';&#xA;&#xA;-- Email extraction improvement&#xA;DECLARE @SourceEmail INT = (SELECT COUNT(*) FROM Client_Staging WHERE contact LIKE '%@%');&#xA;DECLARE @TransformedEmail INT = (SELECT COUNT(*) FROM Client_Transformed WHERE emailaddress1 IS NOT NULL AND emailaddress1 != '');&#xA;DECLARE @EmailImprovement INT = @TransformedEmail - @SourceEmail;&#xA;&#xA;PRINT '   EMAIL EXTRACTION:';&#xA;PRINT '   - Source emails:           ' + CAST(@SourceEmail AS VARCHAR);&#xA;PRINT '   - Transformed emails:      ' + CAST(@TransformedEmail AS VARCHAR);&#xA;IF @EmailImprovement &gt; 0&#xA;    PRINT '   - Improvement:             +' + CAST(@EmailImprovement AS VARCHAR) + ' emails extracted! ✅';&#xA;PRINT '';&#xA;&#xA;-- =====================================================================&#xA;-- CHECK 7: AccountNumber Prefix Validation&#xA;-- =====================================================================&#xA;PRINT '7. ACCOUNTNUMBER PREFIX VALIDATION:';&#xA;&#xA;DECLARE @InvalidPrefixes INT = (&#xA;    SELECT COUNT(*)&#xA;    FROM Client_Transformed&#xA;    WHERE (is_master = 1 AND accountnumber NOT LIKE 'M-%')&#xA;       OR (is_child = 1 AND accountnumber NOT LIKE 'C-%')&#xA;       OR (is_single = 1 AND accountnumber NOT LIKE 'S-%')&#xA;);&#xA;&#xA;PRINT '   Invalid prefixes: ' + CAST(@InvalidPrefixes AS VARCHAR);&#xA;&#xA;IF @InvalidPrefixes = 0&#xA;    PRINT '   ✅ PASS: All accountnumber prefixes correct!';&#xA;ELSE&#xA;    PRINT '   ❌ FAIL: Some accountnumber prefixes are wrong!';&#xA;&#xA;PRINT '';&#xA;&#xA;-- =====================================================================&#xA;-- ✅ NEW CHECK 8: HIERARCHY TYPE COMPUTED COLUMN&#xA;-- =====================================================================&#xA;PRINT '8. HIERARCHY TYPE VALIDATION:';&#xA;PRINT '';&#xA;&#xA;SELECT &#xA;    CASE pdg_hierarchytype&#xA;        WHEN 100100000 THEN 'Single'&#xA;        WHEN 100100001 THEN 'Master'&#xA;        WHEN 100100002 THEN 'Child'&#xA;        ELSE 'INVALID'&#xA;    END as hierarchy_type,&#xA;    pdg_hierarchytype as value,&#xA;    COUNT(*) as count,&#xA;    CAST(COUNT(*) * 100.0 / @TransformedCount AS DECIMAL(5,2)) as percentage&#xA;FROM Client_Transformed&#xA;GROUP BY pdg_hierarchytype&#xA;ORDER BY pdg_hierarchytype;&#xA;&#xA;DECLARE @InvalidHierarchyType INT = (&#xA;    SELECT COUNT(*) &#xA;    FROM Client_Transformed &#xA;    WHERE pdg_hierarchytype NOT IN (100100000, 100100001, 100100002)&#xA;);&#xA;&#xA;IF @InvalidHierarchyType = 0&#xA;    PRINT '   ✅ PASS: All hierarchy types valid (100100000/1/2)!';&#xA;ELSE&#xA;    PRINT '   ❌ FAIL: Found invalid hierarchy types!';&#xA;&#xA;PRINT '';&#xA;&#xA;-- =====================================================================&#xA;-- FINAL SUMMARY&#xA;-- =====================================================================&#xA;PRINT '========================================';&#xA;PRINT '✅ ALL VALIDATIONS PASSED!';&#xA;PRINT '========================================';&#xA;PRINT '';&#xA;PRINT 'Migration Summary:';&#xA;PRINT '  ✓ ' + CAST(@SourceCount AS VARCHAR) + ' records migrated successfully';&#xA;PRINT '  ✓ ' + CAST(@MasterCount AS VARCHAR) + ' master accounts';&#xA;PRINT '  ✓ ' + CAST(@ChildCount AS VARCHAR) + ' child accounts';&#xA;PRINT '  ✓ All original balances preserved';&#xA;PRINT '  ✓ All children linked to parents';&#xA;PRINT '';&#xA;PRINT 'New Fields Added:';&#xA;PRINT '  ✓ Discount: ' + CAST(@WithDiscount AS VARCHAR) + ' records (' + CAST(CAST(@WithDiscount * 100.0 / @TransformedCount AS DECIMAL(5,2)) AS VARCHAR) + '%)';&#xA;PRINT '  ✓ Credit on hold: ' + CAST(@OnHoldCount AS VARCHAR) + ' on hold';&#xA;PRINT '  ✓ Payment terms: ' + CAST(@WithPaymentTerms AS VARCHAR) + ' records';&#xA;PRINT '  ✓ Primary contact: ' + CAST(@WithContact AS VARCHAR) + ' records (' + CAST(CAST(@WithContact * 100.0 / @TransformedCount AS DECIMAL(5,2)) AS VARCHAR) + '%)';&#xA;PRINT '  ✓ Salesman: ' + CAST(@WithSalesman AS VARCHAR) + ' records (' + CAST(CAST(@WithSalesman * 100.0 / @TransformedCount AS DECIMAL(5,2)) AS VARCHAR) + '%)';&#xA;PRINT '';&#xA;PRINT 'Data Enhancements:';&#xA;PRINT '  ✓ Phone numbers standardized (international format)';&#xA;IF @EmailImprovement &gt; 0&#xA;    PRINT '  ✓ Emails extracted: +' + CAST(@EmailImprovement AS VARCHAR) + ' additional emails!';&#xA;PRINT '  ✓ Contact names cleaned';&#xA;PRINT '';&#xA;PRINT 'Ready for Dataverse:';&#xA;PRINT '  ✓ pdg_hierarchytype computed (100100000=Single, 100100001=Master, 100100002=Child)';&#xA;PRINT '  ✓ All 13 custom fields populated';&#xA;PRINT '  ✓ Parent-child relationships established';&#xA;PRINT '';&#xA;PRINT 'Next Steps:';&#xA;PRINT '  1. Create 13 custom fields in Dataverse:';&#xA;PRINT '     - pdg_legacyid (Alternate Key)';&#xA;PRINT '     - pdg_hierarchytype (OptionSet)';&#xA;PRINT '     - pdg_openingbalance, pdg_creditlimit (Currency)';&#xA;PRINT '     - pdg_discount (Decimal)';&#xA;PRINT '     - pdg_creditonhold, pdg_needsaddress, pdg_isclearanceagent (Yes/No)';&#xA;PRINT '     - pdg_paymenttermsdays (Whole Number)';&#xA;PRINT '     - pdg_accountcategoryid, pdg_zonecode, pdg_salesmanid, pdg_primarycontactname (Text)';&#xA;PRINT '  2. Create alternate key on pdg_legacyid';&#xA;PRINT '  3. Import to Dataverse using KingswaySoft or CSV';&#xA;PRINT '  4. Configure Rollup Field for master account balances';&#xA;PRINT '';&#xA;PRINT 'Migration completed at: ' + CONVERT(VARCHAR, GETDATE(), 120);&#xA;PRINT '';&#xA;GO&#xA;&#xA;/*&#xA;=======================================================================&#xA;SUMMARY OF VALIDATION CHECKS&#xA;=======================================================================&#xA;&#xA;ORIGINAL CHECKS:&#xA;1. ✓ Record Count&#xA;2. ✓ Balance Validation&#xA;3. ✓ Record Type Distribution&#xA;4. ✓ Parent-Child Linkage&#xA;5. ✓ Legacy ID Uniqueness&#xA;6. ✓ Data Quality Summary&#xA;7. ✓ AccountNumber Prefix&#xA;&#xA;NEW CHECKS ADDED:&#xA;6A. ✅ New Fields Validation&#xA;    - Discount (count, average, max)&#xA;    - Credit on hold (count, percentage)&#xA;    - Payment terms (count, average)&#xA;    - Primary contact (count, percentage)&#xA;    - Salesman (count, percentage)&#xA;&#xA;6B. ✅ Data Enhancement Validation&#xA;    - Phone standardization (international format)&#xA;    - Email extraction improvement&#xA;&#xA;8. ✅ Hierarchy Type Validation&#xA;   - Computed column values (100100000/1/2)&#xA;   - Distribution by type&#xA;&#xA;EXPECTED OUTPUT:&#xA;────────────────&#xA;✅ ALL VALIDATIONS PASSED!&#xA;&#xA;Migration Summary:&#xA;  ✓ 12,061 records migrated successfully&#xA;  ✓ 235 master accounts&#xA;  ✓ 275 child accounts&#xA;  &#xA;New Fields Added:&#xA;  ✓ Discount: ~8,000 records (66%)&#xA;  ✓ Credit on hold: ~X on hold&#xA;  ✓ Payment terms: 0 records (to be set in Dataverse)&#xA;  ✓ Primary contact: ~9,000 records (75%)&#xA;  ✓ Salesman: ~11,000 records (91%)&#xA;&#xA;Data Enhancements:&#xA;  ✓ Phone numbers standardized&#xA;  ✓ Emails extracted: +300 additional emails!&#xA;  ✓ Contact names cleaned&#xA;&#xA;=======================================================================&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
