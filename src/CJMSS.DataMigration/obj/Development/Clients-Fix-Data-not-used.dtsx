            </component>
            <component
              refId="Package\DFT - Transform Client Data\Read from Hierarchy Mapping"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="Read from Hierarchy Mapping"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- =====================================================================
-- UPDATED OLE DB SOURCE QUERY - TRANSFORM TO STAGING
-- Includes: Discount, Credit Hold, Payment Terms, Primary Contact
-- =====================================================================

SELECT 
    -- ============================================
    -- IDENTIFIERS (from hierarchy mapping)
    -- ============================================
    hm.source_seq as seq,
    hm.pdg_legacyid,
    hm.accountnumber,
    
    -- ============================================
    -- BASIC INFO
    -- ============================================
    hm.customer_name as name,
    CAST(NULL AS NVARCHAR(4000)) as description,
    
    -- ============================================
    -- ADDRESS FIELDS (from staging)
    -- ============================================
    cs.adr as address1_line1,
    cs.adr1 as address1_line2,
    
    -- ============================================
    -- CONTACT FIELDS (from staging)
    -- ============================================
    cs.tel1 as telephone1,
    cs.tel2 as telephone2,
    cs.fax as fax,
    CAST(NULL AS NVARCHAR(200)) as emailaddress1,
    
    -- ============================================
    -- FINANCIAL FIELDS (from staging)
    -- ============================================
    cs.balance as pdg_openingbalance,
    COALESCE(cs.lcred, cs.crdlin) as pdg_creditlimit,
    
    -- ✅ NEW: Discount percentage
    cs.disc as pdg_discount,
    
    -- ✅ NEW: Credit on hold (inverted from chg)
    -- chg = 1 means "allow credit" = NOT on hold
    -- chg = 0 means "no credit" = on hold
    CASE WHEN cs.chg = 1 THEN 0 ELSE 1 END as pdg_creditonhold,
    
    -- ✅ NEW: Payment terms days (not in source, set to NULL or default)
    CAST(NULL AS INT) as pdg_paymenttermsdays,
    
    -- ✅ NEW: Primary contact name
    cs.contact as pdg_primarycontactname,
    
    -- ============================================
    -- HIERARCHY TYPE
    -- ============================================
    CASE hm.record_type
        WHEN N'SINGLE' THEN 100100000
        WHEN N'MASTER' THEN 100100001
        WHEN N'CHILD' THEN 100100002
    END as pdg_hierarchytype,
    
    -- ============================================
    -- PARENT RELATIONSHIP
    -- ============================================
    hm.pdg_legacyid as pdg_parentlegacyid,
    
    -- ============================================
    -- CATEGORY &amp; LOOKUPS
    -- ============================================
    ISNULL(cs.cat, N'') as pdg_category,
    CAST(cs.zone AS NVARCHAR(50)) as pdg_zoneidstring,
    CAST(cs.salm AS NVARCHAR(50)) as pdg_salesmanidstring,
    
    -- ============================================
    -- DATA QUALITY FLAGS
    -- ============================================
    CASE 
        WHEN cs.adr IS NULL OR LTRIM(RTRIM(cs.adr)) = N'' THEN 1 
        ELSE 0 
    END as needs_address,
    
    -- ============================================
    -- RECORD TYPE FLAGS
    -- ============================================
    CASE WHEN hm.record_type = N'MASTER' THEN 1 ELSE 0 END as is_master,
    CASE WHEN hm.record_type = N'CHILD' THEN 1 ELSE 0 END as is_child,
    CASE WHEN hm.record_type = N'SINGLE' THEN 1 ELSE 0 END as is_single,
    
    CAST(NULL AS INT) as parent_seq,
    hm.source_seq as source_seq,
    
    -- ============================================
    -- STATIC VALUES
    -- ============================================
    1 as accountcategorycode,
    0 as pdg_isclearanceagent,
    N'USD' as transactioncurrencycode

FROM dbo.Client_Hierarchy_Mapping hm
INNER JOIN dbo.Client_Staging cs ON hm.source_seq = cs.seq

ORDER BY 
    CASE hm.record_type
        WHEN N'MASTER' THEN 1
        WHEN N'SINGLE' THEN 2
        WHEN N'CHILD' THEN 3
    END,
    hm.source_seq;

/*
=======================================================================
NEW FIELDS MAPPING FROM SOURCE
=======================================================================

Excel Field    →  Staging Column  →  Transformed Column
────────────────────────────────────────────────────────────────
disc           →  disc             →  pdg_discount
chg            →  chg              →  pdg_creditonhold (inverted!)
(none)         →  (none)           →  pdg_paymenttermsdays (NULL)
contact        →  contact          →  pdg_primarycontactname

IMPORTANT - Credit on Hold Logic:
──────────────────────────────────
Source field "chg" (charge):
  chg = 1  →  Allow credit  →  pdg_creditonhold = 0 (NOT on hold)
  chg = 0  →  No credit     →  pdg_creditonhold = 1 (IS on hold)

The field is inverted because:
  - chg = "can charge" (positive)
  - creditonhold = "blocked" (negative)

=======================================================================
PAYMENT TERMS DAYS
=======================================================================

Not in source data. Options:

1. Set to NULL (current approach)
   - Requires manual entry in Dataverse

2. Set default value (e.g., 30 days)
   - Change: CAST(NULL AS INT) to 30

3. Derive from category
   - Add CASE statement based on cat field

Recommendation: Use NULL for now, set default in Dataverse

=======================================================================
*/</property>
                <property
                  dataType="System.String"
                  description="The variable that contains the SQL command to be executed."
                  name="SqlCommandVariable"></property>
                <property
                  dataType="System.Int32"
                  description="Specifies the column code page to use when code page information is unavailable from the data source."
                  name="DefaultCodePage">1252</property>
                <property
                  dataType="System.Boolean"
                  description="Forces the use of the DefaultCodePage property value when describing character data."
                  name="AlwaysUseDefaultCodePage">false</property>
                <property
                  dataType="System.Int32"
                  description="Specifies the mode used to access the database."
                  name="AccessMode"
                  typeConverter="AccessMode">2</property>
                <property
                  dataType="System.String"
                  description="The mappings between the parameters in the SQL command and variables."
                  name="ParameterMapping"></property>
              </properties>
              <connections>
                <connection
                  refId="Package\DFT - Transform Client Data\Read from Hierarchy Mapping.Connections[OleDbConnection]"
                  connectionManagerID="Package.ConnectionManagers[MetierDartStagingDB]"
                  connectionManagerRefId="Package.ConnectionManagers[MetierDartStagingDB]"
                  description="The OLE DB runtime connection used to access the database."
                  name="OleDbConnection" />
              </connections>
