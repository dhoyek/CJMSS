            <component
              refId="Package\DFT - Export to Dataverse\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT 
    -- ============================================
    -- IDENTIFIERS
    -- ============================================
    [seq],
    [pdg_legacyid],
    [accountnumber],
    [name],
    [description],
    
    -- ============================================
    -- ADDRESS (Include all, even if NULL)
    -- ============================================
    [address1_line1],
    [address1_line2],
    [address1_city],                -- ✅ INCLUDE (future-proof)
    [address1_stateorprovince],     -- ✅ INCLUDE (future-proof)
    [address1_postalcode],          -- ✅ INCLUDE (future-proof)
    [address1_country],             -- ✅ INCLUDE (future-proof)
    
    -- ============================================
    -- CONTACT
    -- ============================================
    [telephone1],
    [telephone2],
    [fax],
    [emailaddress1],
    [websiteurl],                   -- ✅ INCLUDE (future-proof)
    
    -- ============================================
    -- FINANCIAL
    -- ============================================
    [pdg_openingbalance],
    [pdg_creditlimit],
    [pdg_discount],
    [pdg_creditonhold],
    [pdg_paymenttermsdays],
    
    -- ============================================
    -- HIERARCHY
    -- ============================================
    [pdg_hierarchytype],
    [is_master],
    [is_child],
    [is_single],
    [parent_seq],
    [pdg_parentlegacyid],
    
    -- ============================================
    -- LOOKUPS
    -- ============================================
    [pdg_category],
    [pdg_zoneidstring],
    [pdg_salesmanidstring],
    [pdg_primarycontactname],
    
    -- ============================================
    -- DATA QUALITY (KEEP ALL!)
    -- ============================================
    [needs_address],                -- ✅ KEEP
    [needs_email],                  -- ✅ KEEP (valuable!)
    [needs_phone],                  -- ✅ KEEP (valuable!)
    
    -- ============================================
    -- REFERENCE
    -- ============================================
    [source_seq],
    
    -- ============================================
    -- AUDIT (EXCLUDE created/modified dates)
    -- ============================================
    -- [created_date] - EXCLUDED (use Dataverse createdon)
    -- [modified_date] - EXCLUDED (use Dataverse modifiedon)
    
    -- ============================================
    -- STATIC VALUES
    -- ============================================
    1 as accountcategorycode,
    0 as pdg_isclearanceagent,
    'USD' as transactioncurrencycode

FROM [dbo].[Client_Transformed]
ORDER BY 
    CASE 
        WHEN is_master = 1 THEN 1
        WHEN is_single = 1 THEN 2
        WHEN is_child = 1 THEN 3
    END,
    seq;</property>
