[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    public override void Input0_ProcessInputRow(Input0Buffer Row)
    {
        Output0Buffer.AddRow();
        Output0Buffer.contactid = Row.contactid;
        Output0Buffer.fullname = Row.fullname;
        Output0Buffer.pdgcontactlegacyid = Row.pdgcontactlegacyid;
        Output0Buffer.needsreview = Row.needsreview;
        Output0Buffer.primaryaccountseq = Row.primaryaccountseq;

        // Validate and clean firstname
        if (!Row.firstname_IsNull && !string.IsNullOrWhiteSpace(Row.firstname))
        {
            string cleaned = CleanName(Row.firstname);
            if (!string.IsNullOrWhiteSpace(cleaned))
            {
                Output0Buffer.firstname = cleaned;
            }
            else
            {
                Output0Buffer.firstname_IsNull = true;
            }
        }
        else
        {
            Output0Buffer.firstname_IsNull = true;
        }

        // Validate and clean lastname
        if (!Row.lastname_IsNull && !string.IsNullOrWhiteSpace(Row.lastname))
        {
            string cleaned = CleanName(Row.lastname);
            if (!string.IsNullOrWhiteSpace(cleaned))
            {
                Output0Buffer.lastname = cleaned;
            }
            else
            {
                Output0Buffer.lastname_IsNull = true;
            }
        }
        else
        {
            Output0Buffer.lastname_IsNull = true;
        }

        // Phone
        if (!Row.samplephone_IsNull)
        {
            Output0Buffer.samplephone = Row.samplephone;
        }
        else
        {
            Output0Buffer.samplephone_IsNull = true;
        }

        // Email
        if (!Row.sampleemail_IsNull)
        {
            Output0Buffer.sampleemail = Row.sampleemail;
        }
        else
        {
            Output0Buffer.sampleemail_IsNull = true;
        }
    }

    private string CleanName(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return null;

        // Remove any remaining numbers
        string cleaned = Regex.Replace(name, @"\d", "");

        // Remove special characters except hyphen and apostrophe
        cleaned = Regex.Replace(cleaned, @"[^a-zA-Z\s\-']", "");

        // Clean whitespace
        cleaned = Regex.Replace(cleaned, @"\s+", " ").Trim();

        // Capitalize first letter
        if (cleaned.Length > 0)
        {
            cleaned = char.ToUpper(cleaned[0]) + cleaned.Substring(1).ToLower();
        }

        return string.IsNullOrWhiteSpace(cleaned) ? null : cleaned;
    }
