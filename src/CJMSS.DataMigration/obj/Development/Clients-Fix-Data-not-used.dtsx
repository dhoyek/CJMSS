                      dataType="System.String"><![CDATA[using System;
using System.Text.RegularExpressions;
using Microsoft.SqlServer.Dts.Pipeline.Wrapper;
using Microsoft.SqlServer.Dts.Runtime.Wrapper;

[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    // Regular expressions for pattern matching
    private static readonly Regex EmailPattern = new Regex(
        @"\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.?[A-Za-z]{0,}\b",
        RegexOptions.Compiled | RegexOptions.IgnoreCase
    );

    public override void Input0_ProcessInputRow(Input0Buffer Row)
    {
        Output0Buffer.AddRow();

        // ============================================
        // IDENTIFIERS
        // ============================================
        Output0Buffer.seq = Row.seq;
        Output0Buffer.pdglegacyid = Row.pdglegacyid ?? string.Empty;
        Output0Buffer.accountnumber = Row.accountnumber ?? string.Empty;

        // ============================================
        // BASIC INFO
        // ============================================
        Output0Buffer.name = Row.name ?? string.Empty;
        Output0Buffer.description = Row.description_IsNull ? string.Empty : Row.description;

        // ============================================
        // ADDRESS FIELDS
        // ============================================
        string address1 = Row.address1line1_IsNull ? string.Empty : Row.address1line1;
        string address2 = Row.address1line2_IsNull ? string.Empty : Row.address1line2;

        Output0Buffer.address1line1 = address1;
        Output0Buffer.address1line2 = address2;

        // ============================================
        // CONTACT FIELDS - WITH ENHANCEMENTS
        // ============================================
        string tel1 = Row.telephone1_IsNull ? string.Empty : Row.telephone1;
        string tel2 = Row.telephone2_IsNull ? string.Empty : Row.telephone2;
        string fax = Row.fax_IsNull ? string.Empty : Row.fax;

        // Clean and standardize phone numbers
        string cleanedTel1 = CleanPhoneNumber(tel1);
        string cleanedTel2 = CleanPhoneNumber(tel2);
        string cleanedFax = CleanPhoneNumber(fax);

        Output0Buffer.telephone1 = cleanedTel1;
        Output0Buffer.telephone2 = cleanedTel2;
        Output0Buffer.fax = cleanedFax;

        // Extract and fix email addresses
        string emailFromContact = Row.emailaddress1_IsNull ? string.Empty : Row.emailaddress1;
        string extractedEmail = ExtractAndFixEmail(emailFromContact, address1, address2);

        Output0Buffer.emailaddress1 = extractedEmail;

        // ============================================
        // FINANCIAL FIELDS
        // ============================================
        Output0Buffer.pdgopeningbalance = Row.pdgopeningbalance_IsNull ? 0 : Row.pdgopeningbalance;
        Output0Buffer.pdgcreditlimit = Row.pdgcreditlimit_IsNull ? 0 : Row.pdgcreditlimit;

        // ✅ NEW: Discount percentage
        Output0Buffer.pdgdiscount = Row.pdgdiscount_IsNull ? 0 : Row.pdgdiscount;

        // ✅ NEW: Credit on hold
        Output0Buffer.pdgcreditonhold = (Row.pdgcreditonhold != 0);

        // ✅ NEW: Payment terms days
        if (Row.pdgpaymenttermsdays_IsNull)
            Output0Buffer.pdgpaymenttermsdays_IsNull = true;
        else
            Output0Buffer.pdgpaymenttermsdays = Row.pdgpaymenttermsdays;

        // ✅ NEW: Primary contact name (clean it)
        string contactName = Row.pdgprimarycontactname_IsNull ? string.Empty : Row.pdgprimarycontactname;
        Output0Buffer.pdgprimarycontactname = CleanContactName(contactName);

        // ============================================
        // HIERARCHY TYPE
        // ============================================
        Output0Buffer.pdghierarchytype = Row.pdghierarchytype;

        // ============================================
        // PARENT RELATIONSHIP
        // ============================================
        Output0Buffer.pdgparentlegacyid = Row.pdgparentlegacyid_IsNull ? string.Empty : Row.pdgparentlegacyid;

        if (Row.parentseq_IsNull)
            Output0Buffer.parentseq_IsNull = true;
        else
            Output0Buffer.parentseq = Row.parentseq;

        // ============================================
        // CATEGORY & OTHER FIELDS
        // ============================================
        Output0Buffer.pdgaccountcategoryid = Row.pdgcategory_IsNull ? string.Empty : Row.pdgcategory;
        Output0Buffer.pdgzonecode = Row.pdgzoneidstring_IsNull ? string.Empty : Row.pdgzoneidstring;
        Output0Buffer.pdgsalespersonstringid = Row.pdgsalesmanidstring_IsNull ? string.Empty : Row.pdgsalesmanidstring;

        // ============================================
        // DATA QUALITY FLAGS
        // ============================================
        Output0Buffer.pdgneedsaddress = (Row.needsaddress != 0);

        // ============================================
        // RECORD TYPE FLAGS
        // ============================================
        Output0Buffer.ismaster = (Row.ismaster != 0);
        Output0Buffer.ischild = (Row.ischild != 0);
        Output0Buffer.issingle = (Row.issingle != 0);

        // ============================================
        // SOURCE REFERENCE
        // ============================================
        Output0Buffer.sourceseq = Row.sourceseq;
    }

    /// <summary>
    /// Clean contact name - remove extra info
    /// </summary>
    private string CleanContactName(string contactName)
    {
        if (string.IsNullOrWhiteSpace(contactName))
            return string.Empty;

        // Remove common prefixes/suffixes
        contactName = contactName.Trim();

        // Remove phone numbers if mixed in
        // Example: "John Smith 03 123 456" → "John Smith"
        contactName = Regex.Replace(contactName, @"\s+\d{2,}[\s\d\-]+$", "");

        // Remove email addresses if mixed in
        contactName = Regex.Replace(contactName, @"\s+\S+@\S+", "");

        // Clean up multiple spaces
        contactName = Regex.Replace(contactName, @"\s+", " ").Trim();

        return contactName;
    }

    /// <summary>
    /// Clean and standardize phone numbers
    /// </summary>
    private string CleanPhoneNumber(string phone)
    {
        if (string.IsNullOrWhiteSpace(phone))
            return string.Empty;

        // Remove any text notes (letters, Mme, H:, etc.)
        string cleaned = Regex.Replace(phone, @"[A-Za-z:]+", "");

        // Remove extra whitespace
        cleaned = cleaned.Trim();

        if (string.IsNullOrWhiteSpace(cleaned))
            return string.Empty;

        // Handle international prefixes
        if (cleaned.StartsWith("00"))
        {
            cleaned = "+" + cleaned.Substring(2);
        }
        else if (cleaned.Length > 8 &&
                (cleaned.StartsWith("966") || cleaned.StartsWith("961") ||
                 cleaned.StartsWith("971") || cleaned.StartsWith("974")))
        {
            cleaned = "+" + cleaned;
        }

        // Standardize format: remove spaces and hyphens, then re-add
        string digitsOnly = Regex.Replace(cleaned, @"[^\d\+]", "");

        if (string.IsNullOrWhiteSpace(digitsOnly))
            return string.Empty;

        // Format based on number type
        if (digitsOnly.StartsWith("+"))
        {
            if (digitsOnly.Length < 5)
                return digitsOnly;

            string countryCode = digitsOnly.Substring(0, 4);
            string remaining = digitsOnly.Substring(4);

            if (remaining.Length >= 8)
            {
                return string.Format("{0} {1} {2} {3}",
                    countryCode,
                    remaining.Substring(0, 2),
                    remaining.Substring(2, 3),
                    remaining.Substring(5)
                );
            }
            else if (remaining.Length > 0)
            {
                return countryCode + " " + remaining;
            }
            else
            {
                return countryCode;
            }
        }
        else if (digitsOnly.Length == 8)
        {
            return string.Format("{0} {1} {2}",
                digitsOnly.Substring(0, 2),
                digitsOnly.Substring(2, 3),
                digitsOnly.Substring(5)
            );
        }
        else if (digitsOnly.Length == 7)
        {
            return string.Format("{0} {1}",
                digitsOnly.Substring(0, 3),
                digitsOnly.Substring(3)
            );
        }

        return digitsOnly;
    }

    /// <summary>
    /// Extract and fix email addresses from multiple fields
    /// </summary>
    private string ExtractAndFixEmail(string contactField, string address1, string address2)
    {
        string email = string.Empty;

        if (!string.IsNullOrWhiteSpace(contactField))
        {
            email = ExtractEmail(contactField);
        }

        if (string.IsNullOrWhiteSpace(email) && !string.IsNullOrWhiteSpace(address1))
        {
            email = ExtractEmail(address1);
        }

        if (string.IsNullOrWhiteSpace(email) && !string.IsNullOrWhiteSpace(address2))
        {
            email = ExtractEmail(address2);
        }

        if (!string.IsNullOrWhiteSpace(email))
        {
            email = FixIncompleteEmail(email);
        }

        return email;
    }

    /// <summary>
    /// Extract email pattern from text
    /// </summary>
    private string ExtractEmail(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return string.Empty;

        Match match = EmailPattern.Match(text);
        if (match.Success)
        {
            return match.Value.ToLower().Trim();
        }

        return string.Empty;
    }

    /// <summary>
    /// Fix truncated/incomplete emails
    /// </summary>
    private string FixIncompleteEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return string.Empty;

        if (Regex.IsMatch(email, @"\.[a-z]{2,}$"))
            return email;

        if (email.EndsWith("."))
        {
            if (email.Contains("@gmail."))
                return email + "com";
            else if (email.Contains("@yahoo."))
                return email + "com";
            else if (email.Contains("@hotmail."))
                return email + "com";
            else if (email.Contains("@outlook."))
                return email + "com";
            else if (email.Contains("@live."))
                return email + "com";
            else
                return email + "com";
        }

        if (email.Contains("@") && !email.Contains("."))
        {
            return email + ".com";
        }

        if (email.Contains("@"))
        {
            string[] parts = email.Split('@');
            if (parts.Length == 2)
            {
                string domain = parts[1].ToLower();

                if (domain.StartsWith("gm") || domain.StartsWith("gmai"))
                    return parts[0] + "@gmail.com";
                else if (domain.StartsWith("yah") || domain.StartsWith("yaho"))
                    return parts[0] + "@yahoo.com";
                else if (domain.StartsWith("hot") || domain.StartsWith("hotm"))
                    return parts[0] + "@hotmail.com";
                else if (domain.StartsWith("out") || domain.StartsWith("outl"))
                    return parts[0] + "@outlook.com";
                else if (!domain.Contains("."))
                    return email + ".com";
            }
        }

        return email;
    }
}

