          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[/*
=============================================
SSIS SCRIPT TASK: Query Existing Dataverse Data (MSAL Version)
=============================================
Purpose: Query existing accounts and zones from Dataverse to populate cache tables
This enables INSERT vs UPDATE logic

? UPDATED VERSION: Uses Microsoft.Identity.Client (MSAL) instead of deprecated ADAL

Script Task Configuration:
- Language: C#
- ReadOnlyVariables: User::DataverseUrl, User::DataverseClientId, User::DataverseClientSecret, User::DataverseTenantId
- ReadWriteVariables: (none)
- Referenced Assemblies: Add these via NuGet Package Manager in VSTA:
  * Microsoft.Identity.Client (v4.61.3 or later)
  * Newtonsoft.Json (v13.0.3 or v12.0.3)
  * System.Net.Http (should be pre-installed)
  * System.Data (should be pre-installed)

NuGet Packages Required (install in Script Task VSTA):
1. Install-Package Microsoft.Identity.Client -Version 4.61.3
2. Install-Package Newtonsoft.Json -Version 13.0.3

=============================================
*/

#region Namespaces
using System;
using System.Data;
using System.Data.SqlClient;
using System.Net.Http;
using System.Net.Http.Headers;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;
using Microsoft.SqlServer.Dts.Runtime;
using Microsoft.Identity.Client;  // ? Modern MSAL library
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
#endregion

namespace ST_QueryDataverse
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        // Class-level variables
        private string dataverseUrl;
        private string accessToken;
        private HttpClient httpClient;

        public void Main()
        {
            try
            {
                // Get configuration from SSIS variables
                dataverseUrl = Dts.Variables["User::DataverseUrl"].Value.ToString().TrimEnd('/');
                string clientId = Dts.Variables["User::DataverseClientId"].Value.ToString();
                string clientSecret = Dts.Variables["User::DataverseClientSecret"].Value.ToString();
                string tenantId = Dts.Variables["User::DataverseTenantId"].Value.ToString();

                Dts.Log("Starting Dataverse cache population", 0, null);
                Dts.Log($"Dataverse URL: {dataverseUrl}", 0, null);

                // Step 1: Get Access Token (using MSAL)
                Dts.Log("Acquiring access token using MSAL...", 0, null);
                accessToken = GetAccessTokenAsync(tenantId, clientId, clientSecret, dataverseUrl).Result;
                Dts.Log("Access token acquired successfully", 0, null);

                // Step 2: Initialize HTTP Client
                InitializeHttpClient();

                // Step 3: Query and cache existing accounts
                Dts.Log("Querying existing accounts from Dataverse...", 0, null);
                int accountCount = QueryAndCacheAccounts();
                Dts.Log($"Cached {accountCount} existing accounts", 0, null);

                // Step 4: Query and cache existing zones
                Dts.Log("Querying existing zones from Dataverse...", 0, null);
                int zoneCount = QueryAndCacheZones();
                Dts.Log($"Cached {zoneCount} existing zones", 0, null);

                // Success
                Dts.Log("Dataverse cache population completed successfully", 0, null);
                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                Dts.Log($"ERROR: {ex.Message}", 0, null);
                Dts.Log($"Stack Trace: {ex.StackTrace}", 0, null);
                Dts.Events.FireError(0, "Script Task", ex.Message, string.Empty, 0);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
            finally
            {
                if (httpClient != null)
                {
                    httpClient.Dispose();
                }
            }
        }

        #region OAuth Authentication (MSAL)

        /// <summary>
        /// Acquire OAuth access token for Dataverse using Microsoft Identity Client Library (MSAL)
        /// </summary>
        private async Task<string> GetAccessTokenAsync(string tenantId, string clientId, string clientSecret, string resource)
        {
            try
            {
                // Build the authority URL
                string authority = $"https://login.microsoftonline.com/{tenantId}";

                // Define the scope - Dataverse requires /.default scope
                string[] scopes = new string[] { $"{resource}/.default" };

                // Create the confidential client application
                IConfidentialClientApplication app = ConfidentialClientApplicationBuilder
                    .Create(clientId)
                    .WithClientSecret(clientSecret)
                    .WithAuthority(new Uri(authority))
                    .Build();

                // Acquire token for client
                AuthenticationResult result = await app
                    .AcquireTokenForClient(scopes)
                    .ExecuteAsync();

                return result.AccessToken;
            }
            catch (MsalServiceException ex)
            {
                throw new Exception($"MSAL Service Error: {ex.Message} (Error Code: {ex.ErrorCode})", ex);
            }
            catch (MsalClientException ex)
            {
                throw new Exception($"MSAL Client Error: {ex.Message} (Error Code: {ex.ErrorCode})", ex);
            }
            catch (Exception ex)
            {
                throw new Exception($"Failed to acquire access token: {ex.Message}", ex);
            }
        }

        #endregion

        #region HTTP Client Setup

        /// <summary>
        /// Initialize HTTP client with proper headers
        /// </summary>
        private void InitializeHttpClient()
        {
            httpClient = new HttpClient();
            httpClient.BaseAddress = new Uri(dataverseUrl);
            httpClient.Timeout = TimeSpan.FromMinutes(10);
            httpClient.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", accessToken);
            httpClient.DefaultRequestHeaders.Accept.Add(new MediaTypeWithQualityHeaderValue("application/json"));
            httpClient.DefaultRequestHeaders.Add("OData-MaxVersion", "4.0");
            httpClient.DefaultRequestHeaders.Add("OData-Version", "4.0");
            httpClient.DefaultRequestHeaders.Add("Prefer", "odata.include-annotations=*");
        }

        #endregion

        #region Query Dataverse

        /// <summary>
        /// Query Dataverse with pagination support
        /// </summary>
        private List<JObject> QueryDataverse(string entitySet, string selectFields, string filter = null)
        {
            var allRecords = new List<JObject>();

            // Build query URL
            string queryUrl = $"/api/data/v9.2/{entitySet}?$select={selectFields}";

            if (!string.IsNullOrEmpty(filter))
            {
                queryUrl += $"&$filter={filter}";
            }

            // Add pagination
            queryUrl += "&$top=5000";

            Dts.Log($"Query URL: {queryUrl}", 0, null);

            try
            {
                // Execute query with pagination
                string nextLink = queryUrl;

                while (!string.IsNullOrEmpty(nextLink))
                {
                    var response = httpClient.GetAsync(nextLink).Result;
                    response.EnsureSuccessStatusCode();

                    string content = response.Content.ReadAsStringAsync().Result;
                    var jsonResult = JObject.Parse(content);

                    // Get records
                    var records = jsonResult["value"] as JArray;
                    if (records != null)
                    {
                        foreach (var record in records)
                        {
                            allRecords.Add(record as JObject);
                        }
                    }

                    // Check for next page
                    nextLink = jsonResult["@odata.nextLink"]?.ToString();

                    if (!string.IsNullOrEmpty(nextLink))
                    {
                        Dts.Log($"Fetching next page... (Total so far: {allRecords.Count})", 0, null);
                    }
                }

                return allRecords;
            }
            catch (Exception ex)
            {
                throw new Exception($"Failed to query Dataverse: {ex.Message}", ex);
            }
        }

        #endregion

        #region Cache Accounts

        /// <summary>
        /// Query existing accounts and populate cache table
        /// </summary>
        private int QueryAndCacheAccounts()
        {
            try
            {
                // Query accounts with pdg_legacyid (which is a string field)
                var accounts = QueryDataverse(
                    entitySet: "accounts",
                    selectFields: "accountid,name,pdg_legacyid,modifiedon",
                    filter: "pdg_legacyid ne null and statecode eq 0"
                );

                Dts.Log($"Retrieved {accounts.Count} accounts from Dataverse", 0, null);

                // Get staging connection string
                string connString = Dts.Connections["ClientMigrationStaging"].ConnectionString;

                using (var conn = new SqlConnection(connString))
                {
                    conn.Open();

                    // Clear cache
                    using (var cmd = new SqlCommand("TRUNCATE TABLE DataverseAccountCache", conn))
                    {
                        cmd.ExecuteNonQuery();
                    }

                    Dts.Log("Inserting accounts into cache...", 0, null);

                    // Bulk insert for performance
                    using (var transaction = conn.BeginTransaction())
                    {
                        try
                        {
                            foreach (var account in accounts)
                            {
                                string sql = @"INSERT INTO DataverseAccountCache 
                                             (pdg_legacyid, accountid, name, modifiedon)
                                             VALUES (@legacyid, @accountid, @name, @modifiedon)";

                                using (var cmd = new SqlCommand(sql, conn, transaction))
                                {
                                    cmd.Parameters.AddWithValue("@legacyid",
                                        account["pdg_legacyid"]?.ToString() ?? string.Empty);
                                    cmd.Parameters.AddWithValue("@accountid",
                                        Guid.Parse(account["accountid"].ToString()));
                                    cmd.Parameters.AddWithValue("@name",
                                        account["name"]?.ToString() ?? string.Empty);

                                    // Handle modifiedon (may be null)
                                    if (account["modifiedon"] != null)
                                    {
                                        cmd.Parameters.AddWithValue("@modifiedon",
                                            DateTime.Parse(account["modifiedon"].ToString()));
                                    }
                                    else
                                    {
                                        cmd.Parameters.AddWithValue("@modifiedon", DBNull.Value);
                                    }

                                    cmd.ExecuteNonQuery();
                                }
                            }

                            transaction.Commit();
                            Dts.Log("Account cache populated successfully", 0, null);
                        }
                        catch (Exception ex)
                        {
                            transaction.Rollback();
                            throw new Exception($"Failed to populate account cache: {ex.Message}", ex);
                        }
                    }
                }

                return accounts.Count;
            }
            catch (Exception ex)
            {
                throw new Exception($"Failed to cache accounts: {ex.Message}", ex);
            }
        }

        #endregion

        #region Cache Zones

        /// <summary>
        /// Query existing zones and populate cache table
        /// </summary>
        private int QueryAndCacheZones()
        {
            try
            {
                // Query zones with pdg_legacyid
                var zones = QueryDataverse(
                    entitySet: "pdg_zones",
                    selectFields: "pdg_zoneid,pdg_legacyid,pdg_name",
                    filter: "pdg_legacyid ne null and statecode eq 0"
                );

                Dts.Log($"Retrieved {zones.Count} zones from Dataverse", 0, null);

                // Get staging connection string
                string connString = Dts.Connections["ClientMigrationStaging"].ConnectionString;

                using (var conn = new SqlConnection(connString))
                {
                    conn.Open();

                    // Clear cache
                    using (var cmd = new SqlCommand("TRUNCATE TABLE DataverseZoneCache", conn))
                    {
                        cmd.ExecuteNonQuery();
                    }

                    Dts.Log("Inserting zones into cache...", 0, null);

                    // Bulk insert
                    using (var transaction = conn.BeginTransaction())
                    {
                        try
                        {
                            foreach (var zone in zones)
                            {
                                string sql = @"INSERT INTO DataverseZoneCache 
                                             (pdg_legacyid, pdg_zoneid, pdg_name)
                                             VALUES (@legacyid, @zoneid, @name)";

                                using (var cmd = new SqlCommand(sql, conn, transaction))
                                {
                                    cmd.Parameters.AddWithValue("@legacyid",
                                        zone["pdg_legacyid"]?.ToString() ?? string.Empty);
                                    cmd.Parameters.AddWithValue("@zoneid",
                                        Guid.Parse(zone["pdg_zoneid"].ToString()));
                                    cmd.Parameters.AddWithValue("@name",
                                        zone["pdg_name"]?.ToString() ?? string.Empty);

                                    cmd.ExecuteNonQuery();
                                }
                            }

                            transaction.Commit();
                            Dts.Log("Zone cache populated successfully", 0, null);
                        }
                        catch (Exception ex)
                        {
                            transaction.Rollback();
                            throw new Exception($"Failed to populate zone cache: {ex.Message}", ex);
                        }
                    }
                }

                return zones.Count;
            }
            catch (Exception ex)
            {
                throw new Exception($"Failed to cache zones: {ex.Message}", ex);
            }
        }

        #endregion

        #region VSTA generated code
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}

/*
=============================================
KEY CHANGES FROM ADAL TO MSAL
=============================================

1. ? Using Statement Changed:
   OLD: using Microsoft.IdentityModel.Clients.ActiveDirectory;
   NEW: using Microsoft.Identity.Client;

2. ? Authentication Method Changed:
   OLD: AuthenticationContext + AcquireTokenAsync
   NEW: ConfidentialClientApplicationBuilder + AcquireTokenForClient

3. ? Scope Format:
   - MSAL requires scope format: "https://yourorg.crm.dynamics.com/.default"
   - The scope is built dynamically from the dataverseUrl

4. ? Error Handling:
   - MSAL has specific exception types: MsalServiceException, MsalClientException
   - Better error messages with ErrorCode property

5. ? Async/Await Pattern:
   - MSAL prefers async patterns (but we use .Result for SSIS compatibility)

=============================================
INSTALLATION INSTRUCTIONS
=============================================

1. Open SSIS package
2. Double-click Script Task
3. Click "Edit Script" to open VSTA
4. In VSTA, open Package Manager Console (Tools ? NuGet Package Manager ? Package Manager Console)
5. Run these commands:
   
   Install-Package Microsoft.Identity.Client -Version 4.61.3
   Install-Package Newtonsoft.Json -Version 13.0.3

6. Save script
7. Close VSTA
8. Save SSIS package

=============================================
TESTING NOTES
=============================================

To test this script task:
1. Set breakpoint at start of Main()
2. Run package in Debug mode
3. Verify:
   - Access token acquired using MSAL
   - Accounts queried from Dataverse
   - Zones queried from Dataverse
   - Cache tables populated
   
Check cache tables after run:
   SELECT COUNT(*) FROM ClientMigrationStaging.dbo.DataverseAccountCache;
   SELECT COUNT(*) FROM ClientMigrationStaging.dbo.DataverseZoneCache;

=============================================
TROUBLESHOOTING
=============================================

Error: "Could not load file or assembly Microsoft.Identity.Client"
Solution: Ensure NuGet package is installed in VSTA Script Task project

Error: "AADSTS700016: Application not found"
Solution: Verify ClientId is correct in Azure AD

Error: "AADSTS7000215: Invalid client secret"
Solution: Verify ClientSecret is correct and not expired

Error: "Insufficient privileges"
Solution: Ensure Azure AD app registration has "Dynamics CRM" API permissions

Error: "Invalid resource"
Solution: Ensure DataverseUrl is in format: https://yourorg.crm.dynamics.com (no trailing slash)

=============================================
ADVANTAGES OF MSAL OVER ADAL
=============================================

1. ? Active Support: Microsoft actively maintains MSAL
2. ? Modern Authentication: Supports latest OAuth 2.0 standards
3. ? Better Performance: Improved token caching
4. ? Enhanced Security: Better protection against common vulnerabilities
5. ? Future-Proof: Will receive updates and new features
6. ?? ADAL is deprecated and will be removed in future versions

=============================================
*/]]></ProjectItem>
