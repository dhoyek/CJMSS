      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B2E46E60-D095-4804-BD16-BBFADA72468C}"
          SQLTask:SqlStatementSource="-- Clear staging tables&#xA;TRUNCATE TABLE ZoneStaging;&#xA;TRUNCATE TABLE ClientStaging;&#xA;TRUNCATE TABLE ZoneUpsert;&#xA;TRUNCATE TABLE ClientUpsert;&#xA;&#xA;-- Start run tracking&#xA;EXEC usp_StartMigrationRun;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
