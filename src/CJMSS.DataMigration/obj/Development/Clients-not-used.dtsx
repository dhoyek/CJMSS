          SQLTask:SqlStatementSource="-- Build zone UPSERT dataset&#xA;EXEC usp_BuildZoneUpsertDataset;&#xA;&#xA;-- Build client UPSERT dataset&#xA;EXEC usp_BuildClientUpsertDataset;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
